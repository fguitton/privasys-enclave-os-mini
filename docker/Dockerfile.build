#
# Reproducible build container for enclave-os-mini.
#
# Produces deterministic SGX enclave binaries → identical MRENCLAVE on every run.
#
# BUILD:
#   docker build -f docker/Dockerfile.build -t privasys/enclave-os-build:v0.3 .
#
# USE (build the enclave; mount the parent Honest repository whose
# third_party/privasys/enclave-os-mini submodule is this tree):
#   docker run --rm --security-opt seccomp=unconfined \
#     -v /path/to/honest-ehds:/honest privasys/enclave-os-build:v0.3
# The SDK input preparation runs bubblewrap, which needs unprivileged user
# namespaces inside the container.
#
# The container outputs, relative to the mounted Mini tree:
#   build/bin/enclave.signed.so   — Signed enclave binary
#   build/bin/enclave-os-host     — Host binary
#   build/mrenclave.txt           — Hex-encoded MRENCLAVE
#
# ─── Pinned versions ─────────────────────────────────────────────────────
# Ubuntu         26.04  (matches the reviewed Autotools/perl inputs)
# GCC            13.x (gcc-13 / g++-13 packages)
# cmake          from Ubuntu repos
# Intel SGX SDK  2.30.101.1  (binary installer, SHA-256 pinned)
# SGX apt pkgs   latest from Intel repo (host-side only, don't affect MRENCLAVE)
# Rust           nightly-2026-06-21  → rustc 1.98.0-nightly (8b6558a02)
# LLVM           22.1.7  (bundled with rustc)
# Teaclave SGX   privasys-v0.4.0  (pinned in Cargo.lock)
# ─────────────────────────────────────────────────────────────────────────

# Pin by tag; for maximum reproducibility, replace with a digest:
#   docker pull ubuntu:24.04 && docker inspect --format='{{index .RepoDigests 0}}' ubuntu:24.04
FROM ubuntu:26.04

LABEL org.opencontainers.image.source="https://github.com/Privasys/enclave-os-mini"
LABEL org.opencontainers.image.description="Reproducible build environment for enclave-os-mini"

# ── Deterministic build environment ──────────────────────────────────────
ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    TZ=UTC \
    SOURCE_DATE_EPOCH=0 \
    CARGO_INCREMENTAL=0 \
    CARGO_HOME=/opt/cargo \
    RUSTUP_HOME=/opt/rustup

ENV PATH="${CARGO_HOME}/bin:${PATH}"

# ── System packages ──────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        gcc-13 \
        g++-13 \
        bubblewrap \
        cmake \
        autoconf \
        automake \
        libtool \
        pkg-config \
        curl \
        wget \
        ca-certificates \
        gnupg \
        git \
        python3 \
        libclang-dev \
    && rm -rf /var/lib/apt/lists/*

# ── Intel SGX SDK (build tools only — no hardware needed) ────────────────
# Add Intel SGX repo
RUN mkdir -p /etc/apt/keyrings \
    && wget -qO- https://download.01.org/intel-sgx/sgx_repo/ubuntu/intel-sgx-deb.key \
       | gpg --dearmor -o /etc/apt/keyrings/intel-sgx.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/intel-sgx.gpg] https://download.01.org/intel-sgx/sgx_repo/ubuntu noble main" \
       > /etc/apt/sources.list.d/intel-sgx.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        libsgx-headers \
        libsgx-enclave-common \
        libsgx-urts \
        libsgx-dcap-ql-dev \
    && rm -rf /var/lib/apt/lists/*
# NOTE: Version pins removed — these packages are host-side / link-time only
# and do not affect MRENCLAVE. The SDK binary installer (pinned below) provides
# sgx_sign, sgx_edger8r, and the enclave-side libraries that matter.

# Install SGX SDK (provides sgx_edger8r, sgx_sign, headers, link libraries)
RUN wget -qO /tmp/sgx_sdk.bin \
        "https://download.01.org/intel-sgx/sgx-linux/2.30.1/distro/ubuntu24.04-server/sgx_linux_x64_sdk_2.30.101.1.bin" \
    && echo "5e3908ad32d271855a8d089da38e1d85590a1bb866452e9578fef198c5ed07d8  /tmp/sgx_sdk.bin" | sha256sum -c - \
    && chmod +x /tmp/sgx_sdk.bin \
    && echo "yes" | /tmp/sgx_sdk.bin --prefix=/opt/intel \
    && rm /tmp/sgx_sdk.bin

# ── Rust toolchain (exact nightly pinned) ────────────────────────────────
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
    | sh -s -- -y --default-toolchain none \
    && rustup toolchain install nightly-2026-06-21 \
         --component rust-src \
         --profile minimal \
    && rustup default nightly-2026-06-21 \
    && rustc --version --verbose

# ── Build script ─────────────────────────────────────────────────────────
COPY docker/build-enclave.sh /usr/local/bin/build-enclave
RUN chmod +x /usr/local/bin/build-enclave

WORKDIR /honest
ENTRYPOINT ["build-enclave"]
