     /// Creates a JSON deserializer from a `&[u8]`.
     pub fn from_slice(bytes: &'a [u8]) -> Self {
         Deserializer::new(read::SliceRead::new(bytes))
+    }
+
+    /// Scratch backing sufficient for a single immutable input slice.
+    ///
+    /// The slice string decoder copies at most the consumed source bytes; its
+    /// UTF-8 emitter may reserve one full codepoint before writing fewer bytes.
+    /// Ignored-container nesting stores at most one byte per input delimiter.
+    /// This covers parser scratch only, not visitor values or Error storage.
+
+    pub fn slice_scratch_capacity(input_bytes: usize) -> Option<usize> {
+        input_bytes.checked_add(read::UTF8_CODEPOINT_BYTES)
+    }
+
+    /// Use already owned scratch backing for the original slice parser.
+    ///
+    /// Returns the input backing unchanged if it cannot cover the complete
+    /// slice. The caller must admit its actual allocation before constructing
+    /// it. Existing visitor, recursion, error and string decoding semantics
+    /// are unchanged; their independent allocations are not paid by this API.
+
+    pub fn from_slice_with_scratch(
+        bytes: &'a [u8],
+        mut scratch: Vec<u8>,
+    ) -> core::result::Result<Self, Vec<u8>> {
+        let enough = Self::slice_scratch_capacity(bytes.len())
+            .map_or(false, |needed| scratch.capacity() >= needed);
+        if !enough {
+            return Err(scratch);
+        }
+        scratch.clear();
+        let mut deserializer = Self::from_slice(bytes);
+        deserializer.scratch = scratch;
+        Ok(deserializer)
+    }
+
+    /// Recover the scratch allocation after finishing the original parser.
+    ///
+    /// Any visitor-owned result remains independent of this temporary storage.
+
+    pub fn into_scratch(self) -> Vec<u8> {
+        self.scratch
     }
 }
 
