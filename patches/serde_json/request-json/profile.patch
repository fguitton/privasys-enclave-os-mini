+// Same original parser and Error values, with only scratch ownership supplied.
+
+fn from_slice_preallocated<T: de::DeserializeOwned>(input: &[u8]) -> serde_json::Result<T> {
+    let capacity = Deserializer::slice_scratch_capacity(input.len()).unwrap();
+    let mut scratch = Vec::new();
+    scratch.try_reserve_exact(capacity).unwrap();
+    let pointer = scratch.as_ptr();
+    let actual_capacity = scratch.capacity();
+    let mut parser = match Deserializer::from_slice_with_scratch(input, scratch) {
+        Ok(parser) => parser,
+        Err(_) => panic!("complete caller backing refused"),
+    };
+    let result = T::deserialize(&mut parser).and_then(|value| parser.end().map(|()| value));
+    let scratch = parser.into_scratch();
+    assert_eq!(scratch.capacity(), actual_capacity);
+    assert_eq!(scratch.as_ptr(), pointer, "parser scratch reallocated");
+    result
+}
