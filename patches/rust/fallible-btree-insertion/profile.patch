+/// Visit precisely the layouts required by the vacant leaf's full ancestor chain.
+/// This shared plan performs no allocation and does not modify the tree.
+pub(super) fn visit_insert_layouts<K, V, E>(
+    node: Option<NodeRef<marker::Immut<'_>, K, V, marker::LeafOrInternal>>,
+    mut visit: impl FnMut(Layout) -> Result<(), E>,
+) -> Result<(), E> {
+    let Some(mut node) = node else {
+        return visit(Layout::new::<LeafNode<K, V>>());
+    };
+    loop {
+        if node.len() < CAPACITY {
+            return Ok(());
+        }
+        let layout = if node.height() == 0 {
+            Layout::new::<LeafNode<K, V>>()
+        } else {
+            Layout::new::<InternalNode<K, V>>()
+        };
+        visit(layout)?;
+        match node.ascend() {
+            Ok(parent) => node = parent.into_node().forget_type(),
+            Err(_) => return visit(Layout::new::<InternalNode<K, V>>()),
+        }
+    }
+}
