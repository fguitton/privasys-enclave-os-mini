+// SAFETY: every returned block came from this same allocator with this exact
+// layout. Only the exclusive insertion borrows the facade, and takes each block
+// once. Node destruction continues using the map's original allocator.
+#[unstable(feature = "allocator_api", issue = "32838")]
+unsafe impl<A: Allocator> Allocator for &InsertAllocation<A> {
+    fn allocate(&self, layout: Layout) -> Result<NonNull<[u8]>, AllocError> {
+        for slot in &self.blocks[..self.count] {
+            if let Some(block) = slot.get() {
+                if block.layout == layout {
+                    slot.set(None);
+                    return Ok(block.pointer);
+                }
+            }
+        }
+        // No backend allocation can occur after mutation begins.
+        Err(AllocError)
+    }
+
+    unsafe fn deallocate(&self, pointer: NonNull<u8>, layout: Layout) {
+        // SAFETY: the caller provides the original pointer and allocation layout.
+        unsafe { self.alloc.deallocate(pointer, layout) };
+    }
+}
