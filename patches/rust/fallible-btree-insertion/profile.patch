+/// Reserve the shared exact plan before the first tree mutation.
+pub(super) fn reserve_insert<K, V, A: Allocator>(
+    handle: Option<&Handle<NodeRef<marker::Mut<'_>, K, V, marker::Leaf>, marker::Edge>>,
+    alloc: A,
+) -> Result<InsertAllocation<A>, AllocError> {
+    let mut reserved = InsertAllocation::new(alloc);
+    visit_insert_layouts(
+        handle.map(|handle| handle.reborrow().into_node().forget_type()),
+        |layout| reserved.reserve(layout),
+    )?;
+    Ok(reserved)
+}
