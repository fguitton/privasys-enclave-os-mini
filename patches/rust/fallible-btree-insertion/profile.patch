+// One insertion can split at most one node per existing level, then add one
+// root. Every internal node has at least two children, so even the smallest
+// legal tree of height h has at least 2^(h+1)-1 keys. This pointer-width bound
+// therefore covers every representable tree without heap metadata.
+const INSERT_ALLOCATION_SLOTS: usize = usize::BITS as usize + 1;
+
+#[derive(Clone, Copy)]
+struct InsertBlock {
+    pointer: NonNull<[u8]>,
+    layout: Layout,
+}
+
+/// Actual backend blocks reserved before a vacant insertion mutates its tree.
+/// Nodes retain the map's original allocator; the borrowed facade never escapes.
+pub(super) struct InsertAllocation<A: Allocator> {
+    alloc: A,
+    blocks: [Cell<Option<InsertBlock>>; INSERT_ALLOCATION_SLOTS],
+    count: usize,
+}
+
+impl<A: Allocator> InsertAllocation<A> {
+    fn new(alloc: A) -> Self {
+        Self { alloc, blocks: [const { Cell::new(None) }; INSERT_ALLOCATION_SLOTS], count: 0 }
+    }
+
+    pub(super) fn assert_consumed(&self) {
+        // The exact layout multiset was taken once by the existing insertion.
+        // A reservation miss cannot turn into an unadmitted backend allocation;
+        // an excess reservation is an implementation error, not successful proof.
+        assert!(self.blocks[..self.count].iter().all(|slot| slot.get().is_none()));
+    }
+
+    fn reserve(&mut self, layout: Layout) -> Result<(), AllocError> {
+        let slot = self.blocks.get(self.count).ok_or(AllocError)?;
+        let pointer = self.alloc.allocate(layout)?;
+        slot.set(Some(InsertBlock { pointer, layout }));
+        self.count += 1;
+        Ok(())
+    }
+}
+
+impl<A: Allocator> Drop for InsertAllocation<A> {
+    fn drop(&mut self) {
+        for slot in &self.blocks[..self.count] {
+            if let Some(block) = slot.take() {
+                // SAFETY: this is an unused original allocation with its exact layout.
+                unsafe { self.alloc.deallocate(block.pointer.cast(), block.layout) };
+            }
+        }
+    }
