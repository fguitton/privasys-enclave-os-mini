+/// Exact retained nodes after inserting `count` distinct ascending keys into an
+/// empty tree. This is fresh sorted-insertion geometry, not Clone or an arbitrary
+/// existing tree's geometry. No keys, shadow tree or allocations are constructed.
+pub(super) fn visit_sorted_build_layouts<K, V>(
+    count: usize,
+    mut visit: impl FnMut(Layout, usize) -> Result<(), AllocError>,
+) -> Result<(), AllocError> {
+    if count == 0 {
+        return Ok(());
+    }
+    // Appending to a full node promotes this actual splitpoint. The right node
+    // contains CAPACITY - promoted keys after insertion; each subsequent split
+    // therefore occurs after promoted + 1 more incoming keys.
+    let stride = splitpoint(CAPACITY).0.checked_add(1).ok_or(AllocError)?;
+    let nodes = |incoming: usize| {
+        if incoming <= CAPACITY {
+            Ok(1)
+        } else {
+            // ceil((incoming - CAPACITY) / stride), without overflowing an add.
+            ((incoming - CAPACITY - 1) / stride).checked_add(2).ok_or(AllocError)
+        }
+    };
+    let leaves = nodes(count)?;
+    let mut incoming = leaves - 1;
+    let mut internal = 0usize;
+    while incoming != 0 {
+        let level = nodes(incoming)?;
+        internal = internal.checked_add(level).ok_or(AllocError)?;
+        incoming = level - 1;
+    }
+    visit(Layout::new::<LeafNode<K, V>>(), leaves)?;
+    if internal != 0 {
+        visit(Layout::new::<InternalNode<K, V>>(), internal)?;
+    }
+    Ok(())
+}
