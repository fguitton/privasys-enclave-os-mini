+//! Integration observations over the current queue and record transaction.
+//! Fixed observer/provider metadata is outside measured product backing.
+use alloc::boxed::Box;
+use alloc::vec::Vec;
+use core::alloc::{AllocError, Allocator};
+
+use crate::common_state::{CommonState, Side};
+use crate::crypto::cipher::{
+    AeadKey, Iv, MessageEncrypter, OutboundOpaqueMessage, OutboundPlainMessage, PrefixedPayload,
+    SelectedEncrypter,
+};
+use crate::vecbuf::ChunkVecBuffer;
+use crate::{ConnectionCommon, Error, ProtocolVersion, RetainedAllocator};
+
+/// Opaque structural owner using the same production descriptor transaction.
+pub struct QueueProbe<A: Allocator + Clone> {
+    queue: ChunkVecBuffer<A>,
+    pending: Option<Vec<u8, A>>,
+    allocator: A,
+}
+impl<A: Allocator + Clone> QueueProbe<A> {
+    /// Create an empty owner with the supplied original allocator.
+    pub fn new_in(allocator: A) -> Self {
+        Self {
+            queue: ChunkVecBuffer::new_in(None, allocator.clone()),
+            pending: None,
+            allocator,
+        }
+    }
+    /// Observe the live descriptor capacity.
+    pub fn descriptor_capacity(&self) -> usize {
+        self.queue.descriptor_capacity()
+    }
+    /// Borrow the first remaining payload.
+    pub fn first(&self) -> Option<&[u8]> {
+        self.queue.chunks().next()
+    }
+    /// Borrow all queued remaining payloads without allocating.
+    pub fn chunks(&self) -> impl Iterator<Item = &[u8]> {
+        self.queue.chunks()
+    }
+    /// Borrow the retained pending owner.
