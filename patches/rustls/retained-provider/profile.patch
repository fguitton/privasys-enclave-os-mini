+            .map_err(|_| ServerConfigAllocationError::Allocation)?;
+        let cert_compression_cache =
+            Arc::try_new(cache).map_err(|_| ServerConfigAllocationError::Allocation)?;
+        Ok(Self {
+            session_storage,
+            ticketer,
+            key_log,
+            cert_compressors,
+            cert_compression_cache,
+            cert_decompressors,
+        })
+    }
