+impl<A: Allocator + Clone> Debug for CompressionCache<A> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        match self {
+            Self::Disabled => f.write_str("Disabled"),
+            Self::Enabled(inner) => f.debug_tuple("Enabled").field(inner).finish(),
+        }
+    }
+}
+impl<A: Allocator + Clone> Debug for CompressionCacheInner<A> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("CompressionCacheInner")
+            .field("size", &self.size)
+            .field("entries", &self.entries)
+            .finish()
+    }
+}
