+/// One current incremental context and its original physical allocator.
+/// The provider is borrowed only internally; finalization consumes this carrier.
+pub struct ContextBox {
+    inner: RetainedBox<dyn Context>,
+}
+impl ContextBox {
+    /// Physically admit the exact concrete provider context before publishing it.
+    pub fn try_new_in<C: Context + 'static>(
+        context: C,
+        allocator: RetainedAllocator,
+    ) -> Result<Self, Error> {
+        let inner: RetainedBox<dyn Context> =
+            try_box_in(context, allocator).map_err(|_| Error::AllocationFailed)?;
+        Ok(Self { inner })
+    }
+    /// The exact dynamic allocation Layout, excluding allocator backend metadata.
+    pub fn allocation_layout(&self) -> core::alloc::Layout {
+        core::alloc::Layout::for_value(&*self.inner)
+    }
+    /// Read the current prefix without allocating another context Box.
+    pub fn fork_finish(&self) -> Output {
+        self.inner.fork_finish()
+    }
+    /// Allocate one independent prefix copy under the explicit origin.
+    pub fn fork(&self, allocator: RetainedAllocator) -> Result<Self, Error> {
+        self.inner.fork(allocator)
+    }
+    /// Finalize once, retaining the backing and payer through provider completion.
+    pub fn finish(mut self) -> Output {
+        self.inner.take_output()
+    }
+    /// Add input to this live context.
+    pub fn update(&mut self, data: &[u8]) {
+        self.inner.update(data);
+    }
+}
