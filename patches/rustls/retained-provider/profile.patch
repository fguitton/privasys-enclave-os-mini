+/// Admit both actual output growth and optional retained transcript growth
+/// before copying/encoding/hash work. Failure drops only staged new owners.
+pub(crate) fn append_flight<A: core::alloc::Allocator + Clone>(
+    body: &mut Vec<u8, A>,
+    transcript: &mut HandshakeHash<A>,
+    hs: &HandshakeMessagePayload<'_>,
+) -> Result<(), Error> {
+    let length = hs.encoded_length()?;
+    let start = body.len();
+    let end = start.checked_add(length).ok_or(Error::AllocationFailed)?;
+    let mut replacement = if end > body.capacity() {
+        let mut bytes = Vec::new_in(body.allocator().clone());
+        bytes
+            .try_reserve_exact(body.capacity().checked_mul(2).unwrap_or(end).max(end))
+            .map_err(|_| Error::AllocationFailed)?;
+        Some(bytes)
+    } else {
+        None
+    };
+    let prepared_transcript = transcript.prepare_add(length)?;
+    let output = match &mut replacement {
+        Some(bytes) => {
+            bytes.extend_from_slice(body);
+            bytes
+        }
+        None => &mut *body,
+    };
+    hs.encode(&mut crate::msgs::codec::AdmittedEncoding { bytes: output, end });
+    assert_eq!(output.len(), end, "codec changed after admission");
+    transcript.commit_add(&output[start..], prepared_transcript);
+    if let Some(replacement) = replacement {
+        *body = replacement;
+    }
+    Ok(())
+}
