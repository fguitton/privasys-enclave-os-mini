 use crate::suites::ConnectionTrafficSecrets;
 
+/// Current selected cipher owner; ring state is inline and other providers retain their own boxes.
+pub struct SelectedEncrypter(SelectedEncrypterKind);
+enum SelectedEncrypterKind {
+    Provider(Box<dyn MessageEncrypter>),
+    #[cfg(feature = "ring")]
+    Ring13(crate::crypto::ring::tls13::Tls13MessageEncrypter),
+    #[cfg(all(feature = "ring", feature = "tls12"))]
+    Ring12Gcm(crate::crypto::ring::tls12::GcmMessageEncrypter),
+    #[cfg(all(feature = "ring", feature = "tls12"))]
+    Ring12ChaCha(crate::crypto::ring::tls12::ChaCha20Poly1305MessageEncrypter),
+}
+impl SelectedEncrypter {
+    fn as_mut(&mut self) -> &mut dyn MessageEncrypter {
+        match &mut self.0 {
+            SelectedEncrypterKind::Provider(value) => value.as_mut(),
+            #[cfg(feature = "ring")]
+            SelectedEncrypterKind::Ring13(value) => value,
+            #[cfg(all(feature = "ring", feature = "tls12"))]
+            SelectedEncrypterKind::Ring12Gcm(value) => value,
+            #[cfg(all(feature = "ring", feature = "tls12"))]
+            SelectedEncrypterKind::Ring12ChaCha(value) => value,
+        }
+    }
+    fn as_ref(&self) -> &dyn MessageEncrypter {
+        match &self.0 {
+            SelectedEncrypterKind::Provider(value) => value.as_ref(),
+            #[cfg(feature = "ring")]
+            SelectedEncrypterKind::Ring13(value) => value,
+            #[cfg(all(feature = "ring", feature = "tls12"))]
+            SelectedEncrypterKind::Ring12Gcm(value) => value,
+            #[cfg(all(feature = "ring", feature = "tls12"))]
+            SelectedEncrypterKind::Ring12ChaCha(value) => value,
+        }
+    }
+}
+impl<T: MessageEncrypter + 'static> From<Box<T>> for SelectedEncrypter {
+    fn from(value: Box<T>) -> Self {
+        Self(SelectedEncrypterKind::Provider(value))
+    }
+}
+impl From<Box<dyn MessageEncrypter>> for SelectedEncrypter {
+    fn from(value: Box<dyn MessageEncrypter>) -> Self {
+        Self(SelectedEncrypterKind::Provider(value))
+    }
+}
+#[cfg(feature = "ring")]
+impl From<crate::crypto::ring::tls13::Tls13MessageEncrypter> for SelectedEncrypter {
+    fn from(value: crate::crypto::ring::tls13::Tls13MessageEncrypter) -> Self {
+        Self(SelectedEncrypterKind::Ring13(value))
+    }
+}
+#[cfg(all(feature = "ring", feature = "tls12"))]
