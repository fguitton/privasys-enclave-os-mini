+/// One current chosen signer. Standard provider objects keep their existing
+/// boxed dispatch; the selected retained P256 signer is an inline Arc alias.
+pub struct SelectedSigner(SelectedSignerKind);
+enum SelectedSignerKind {
+    Provider(Box<dyn Signer>),
+    #[cfg(feature = "ring")]
+    P256(Arc<crate::crypto::ring::ring_like::signature::EcdsaKeyPair>),
+}
+impl SelectedSigner {
+    #[cfg(feature = "ring")]
+    pub(crate) fn p256(key: Arc<crate::crypto::ring::ring_like::signature::EcdsaKeyPair>) -> Self {
+        Self(SelectedSignerKind::P256(key))
+    }
+    /// Sign without copying a selected P256 signature into a Vec.
+    pub fn sign(&self, message: &[u8]) -> Result<Signature, Error> {
+        match &self.0 {
+            SelectedSignerKind::Provider(signer) => signer.sign(message).map(Signature::from),
+            #[cfg(feature = "ring")]
+            SelectedSignerKind::P256(key) => key
+                .sign(
+                    &crate::crypto::ring::ring_like::rand::SystemRandom::new(),
+                    message,
+                )
+                .map(|signature| Signature(SignatureBytes::Ring(signature)))
+                .map_err(|_| Error::SigningFailed),
+        }
+    }
+    /// The originally selected TLS signature scheme.
+    pub fn scheme(&self) -> SignatureScheme {
+        match &self.0 {
+            SelectedSignerKind::Provider(signer) => signer.scheme(),
+            #[cfg(feature = "ring")]
+            SelectedSignerKind::P256(_) => SignatureScheme::ECDSA_NISTP256_SHA256,
+        }
+    }
+}
+impl<T: Signer + 'static> From<Box<T>> for SelectedSigner {
+    fn from(signer: Box<T>) -> Self {
+        Self(SelectedSignerKind::Provider(signer))
+    }
+}
+impl From<Box<dyn Signer>> for SelectedSigner {
+    fn from(signer: Box<dyn Signer>) -> Self {
+        Self(SelectedSignerKind::Provider(signer))
+    }
+}
+impl Debug for SelectedSigner {
+    fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        formatter
+            .debug_struct("SelectedSigner")
+            .field("scheme", &self.scheme())
+            .finish()
+    }
+}
+
+/// Encoded signature bytes. The ring value owns its actual inline bound and is
+/// cloned inline; no handwritten maximum, allocator conversion or wire tag.
+#[derive(Clone)]
+pub struct Signature(SignatureBytes);
+#[derive(Clone)]
+enum SignatureBytes {
+    Provider(Vec<u8>),
+    #[cfg(feature = "ring")]
+    Ring(crate::crypto::ring::ring_like::signature::Signature),
+}
+impl AsRef<[u8]> for Signature {
+    fn as_ref(&self) -> &[u8] {
+        match &self.0 {
+            SignatureBytes::Provider(bytes) => bytes,
+            #[cfg(feature = "ring")]
+            SignatureBytes::Ring(signature) => signature.as_ref(),
+        }
+    }
+}
+impl core::ops::Deref for Signature {
+    type Target = [u8];
+    fn deref(&self) -> &[u8] {
+        self.as_ref()
+    }
+}
+impl From<Vec<u8>> for Signature {
+    fn from(bytes: Vec<u8>) -> Self {
+        Self(SignatureBytes::Provider(bytes))
+    }
+}
+impl Debug for Signature {
+    fn fmt(&self, formatter: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        for byte in self.as_ref() {
+            write!(formatter, "{byte:02x}")?;
+        }
+        Ok(())
+    }
 }
 
