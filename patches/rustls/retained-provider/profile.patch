+/// Construct the identical default algorithm lists with fallible backing storage.
+pub fn try_default_provider() -> Result<CryptoProvider, DefaultProviderAllocationError> {
+    let mut cipher_suites = alloc::vec::Vec::new();
+    cipher_suites
+        .try_reserve_exact(DEFAULT_CIPHER_SUITES.len())
+        .map_err(|_| DefaultProviderAllocationError)?;
+    let mut kx_groups = alloc::vec::Vec::new();
+    kx_groups
+        .try_reserve_exact(DEFAULT_KX_GROUPS.len())
+        .map_err(|_| DefaultProviderAllocationError)?;
+    // The caller prepays these exact backing layouts. Refuse an allocator that
+    // reports a larger retained capacity rather than publish uncharged storage.
+    if cipher_suites.capacity() != DEFAULT_CIPHER_SUITES.len()
+        || kx_groups.capacity() != DEFAULT_KX_GROUPS.len()
+    {
+        return Err(DefaultProviderAllocationError);
+    }
+    cipher_suites.extend_from_slice(DEFAULT_CIPHER_SUITES);
+    kx_groups.extend_from_slice(DEFAULT_KX_GROUPS);
+    Ok(provider_with_buffers(cipher_suites, kx_groups))
