+pub struct ParsedHandshakeProbe<'a, A: Allocator + Clone> {
+    parsed: Box<crate::msgs::handshake::HandshakeMessagePayload<'a>, A>,
+}
+impl<'a, A: Allocator + Clone> ParsedHandshakeProbe<'a, A> {
+    /// Existing wire validation happens before fixed owner admission.
+    pub fn read_in(
+        wire: &'a [u8],
+        allocator: A,
+        context: RetainedAllocator,
+    ) -> Result<Self, crate::InvalidMessage> {
+        let mut input = crate::msgs::codec::Reader::init_in(wire, context);
+        let parsed = crate::msgs::message::read_parsed_box_in(
+            &mut input,
+            ProtocolVersion::TLSv1_2,
+            allocator,
+        )?;
+        Ok(Self { parsed })
+    }
+    /// The same final owner factory admits bounded overlap before normalization.
+    pub fn try_into_owned(self) -> Result<ParsedHandshakeProbe<'static, A>, crate::InvalidMessage> {
+        crate::msgs::message::try_own_parsed_box(self.parsed)
+            .map(|parsed| ParsedHandshakeProbe { parsed })
+    }
+    /// Exact concrete backing request, with no guessed payload quote.
+    pub fn layout(&self) -> core::alloc::Layout {
+        core::alloc::Layout::for_value(&*self.parsed)
+    }
+    /// Observe the validated semantic type without an owning escape.
+    pub fn handshake_type(&self) -> crate::HandshakeType {
+        self.parsed.0.handshake_type()
+    }
+}
+
+/// Visit the actual message constructor only after successful owner admission.
+/// Non-handshake content uses the original branch and requests no parsed box.
+pub fn visit_message_in(
+    typ: crate::ContentType,
+    wire: &[u8],
+    allocator: RetainedAllocator,
+    visit: impl FnOnce(Option<crate::HandshakeType>, &[u8]),
+) -> Result<(), crate::InvalidMessage> {
+    let payload = crate::msgs::message::MessagePayload::new_in(
+        typ,
+        ProtocolVersion::TLSv1_2,
+        wire,
+        allocator,
+    )?;
+    match &payload {
+        crate::msgs::message::MessagePayload::Handshake { parsed, encoded } => {
+            visit(Some(parsed.0.handshake_type()), encoded.bytes());
+        }
+        _ => visit(None, wire),
+    }
+    Ok(())
+}
