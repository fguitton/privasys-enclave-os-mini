+// Exactly the u16 extension-type namespace; no heap owner or new protocol cap.
+struct ClientExtensionDuplicates {
+    words: [u64; (u16::MAX as usize + 1) / u64::BITS as usize],
+}
+impl ClientExtensionDuplicates {
+    fn new() -> Self {
+        Self {
+            words: [0; (u16::MAX as usize + 1) / u64::BITS as usize],
+        }
+    }
+    fn check(&mut self, typ: ExtensionType) -> Result<(), InvalidMessage> {
+        let index = usize::from(u16::from(typ));
+        let word = &mut self.words[index / u64::BITS as usize];
+        let mask = 1_u64 << (index % u64::BITS as usize);
+        if *word & mask != 0 {
+            return Err(InvalidMessage::DuplicateExtension(u16::from(typ)));
+        }
+        *word |= mask;
+        Ok(())
+    }
+}
