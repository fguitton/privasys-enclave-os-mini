+/// Concrete shared payloads in the selected PKCS8/P256 constructor. Arc header
+/// and padding are added by the config owner before either request executes.
+pub fn retained_p256_payload_layouts() -> [core::alloc::Layout; 2] {
+    [
+        core::alloc::Layout::new::<EcdsaKeyPair>(),
+        core::alloc::Layout::new::<RetainedP256SigningKey<crate::RetainedAllocator>>(),
+    ]
+}
+
+/// The actual three requests made by the current SPKI constructor. The first
+/// two are working buffers; the third survives in the signing key.
+pub fn retained_p256_spki_layouts(
+    point_bytes: usize,
+) -> Result<[core::alloc::Layout; 3], core::alloc::AllocError> {
+    use crate::x509::retained_der_capacity;
+    let algorithm = retained_der_capacity(alg_id::ECDSA_P256.as_ref().len())?;
+    let bit_string =
+        retained_der_capacity(point_bytes.checked_add(1).ok_or(core::alloc::AllocError)?)?;
+    let final_bytes = retained_der_capacity(
+        algorithm
+            .checked_add(bit_string)
+            .ok_or(core::alloc::AllocError)?,
+    )?;
+    Ok([
+        core::alloc::Layout::array::<u8>(algorithm).map_err(|_| core::alloc::AllocError)?,
+        core::alloc::Layout::array::<u8>(bit_string).map_err(|_| core::alloc::AllocError)?,
+        core::alloc::Layout::array::<u8>(final_bytes).map_err(|_| core::alloc::AllocError)?,
+    ])
+}
+
+/// Query the exact existing P-256 SPKI requests without an owned key copy.
+pub fn retained_p256_spki_layouts_for_key(
+    der: &PrivateKeyDer<'_>,
+) -> Result<[core::alloc::Layout; 3], crate::server::ServerConfigAllocationError> {
+    use crate::server::ServerConfigAllocationError as Refusal;
+    let PrivateKeyDer::Pkcs8(pkcs8) = der else {
+        return Err(Refusal::PrivateKey);
+    };
+    let key = EcdsaKeyPair::from_pkcs8(
+        &signature::ECDSA_P256_SHA256_ASN1_SIGNING,
+        pkcs8.secret_pkcs8_der(),
+        &SystemRandom::new(),
+    )
+    .map_err(|_| Refusal::PrivateKey)?;
+    retained_p256_spki_layouts(key.public_key().as_ref().len()).map_err(|_| Refusal::Allocation)
+}
+
+/// Parse the actual retained server leaf key with fallible metadata and SPKI.
+/// This explicitly selected constructor has no generic-key/provider fallback.
+pub fn try_p256_signing_key_in<A>(
+    der: &PrivateKeyDer<'_>,
+    allocator: A,
+) -> Result<Arc<dyn SigningKey>, crate::server::ServerConfigAllocationError>
+where
+    A: core::alloc::Allocator + Clone + Send + Sync + 'static,
+{
+    use crate::server::ServerConfigAllocationError as Refusal;
+    let PrivateKeyDer::Pkcs8(pkcs8) = der else {
+        return Err(Refusal::PrivateKey);
+    };
+    let key = EcdsaKeyPair::from_pkcs8(
+        &signature::ECDSA_P256_SHA256_ASN1_SIGNING,
+        pkcs8.secret_pkcs8_der(),
+        &SystemRandom::new(),
+    )
+    .map_err(|_| Refusal::PrivateKey)?;
+    let key = Arc::try_new(key).map_err(|_| Refusal::Allocation)?;
+    let public_spki = retained_p256_spki(key.public_key().as_ref(), allocator)
+        .map_err(|_| Refusal::Allocation)?;
+    let retained = Arc::try_new(RetainedP256SigningKey { key, public_spki })
+        .map_err(|_| Refusal::Allocation)?;
+    Ok(retained)
+}
+
+fn retained_p256_spki<A: core::alloc::Allocator + Clone>(
+    public_key: &[u8],
+    allocator: A,
+) -> Result<Vec<u8, A>, core::alloc::AllocError> {
+    // Same three DER wrappers as public_key_to_spki. Temporary and retained
+    // buffers each own the original allocator; no infallible Vec conversion.
+    let algorithm = crate::x509::try_asn1_wrap_in(
+        crate::x509::DER_SEQUENCE_TAG,
+        alg_id::ECDSA_P256.as_ref(),
+        &[],
+        allocator.clone(),
+    )?;
+    let bit_string = crate::x509::try_asn1_wrap_in(
+        crate::x509::DER_BIT_STRING_TAG,
+        &[0],
+        public_key,
+        allocator.clone(),
+    )?;
+    crate::x509::try_asn1_wrap_in(
+        crate::x509::DER_SEQUENCE_TAG,
+        &algorithm,
+        &bit_string,
+        allocator,
+    )
+}
+
+struct RetainedP256SigningKey<A: core::alloc::Allocator> {
+    key: Arc<EcdsaKeyPair>,
+    public_spki: Vec<u8, A>,
+}
+impl<A: core::alloc::Allocator + Send + Sync> SigningKey for RetainedP256SigningKey<A> {
+    fn choose_scheme(&self, offered: &[SignatureScheme]) -> Option<SelectedSigner> {
+        offered
+            .contains(&SignatureScheme::ECDSA_NISTP256_SHA256)
+            .then(|| SelectedSigner::p256(self.key.clone()))
+    }
+    fn public_key(&self) -> Option<SubjectPublicKeyInfoDer<'_>> {
+        Some(SubjectPublicKeyInfoDer::from(self.public_spki.as_slice()))
+    }
+    fn algorithm(&self) -> SignatureAlgorithm {
+        SignatureAlgorithm::ECDSA
+    }
+}
+impl<A: core::alloc::Allocator> Debug for RetainedP256SigningKey<A> {
+    fn fmt(&self, formatter: &mut Formatter<'_>) -> fmt::Result {
+        formatter
+            .debug_struct("RetainedP256SigningKey")
+            .field("scheme", &SignatureScheme::ECDSA_NISTP256_SHA256)
+            .finish()
+    }
