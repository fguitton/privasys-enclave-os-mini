+/// Opaque ownership of the current decoder's actual ClientHello fields.
+/// This internal testing surface carries no certificate or connection authority.
+pub struct RetainedClientHello<A: Allocator + Clone> {
+    value: ClientHelloPayload<A>,
+}
+impl<A: Allocator + Clone> fmt::Debug for RetainedClientHello<A> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        self.value.fmt(f)
+    }
+}
+impl<A: Allocator + Clone> RetainedClientHello<A> {
+    /// Decode the same live payload while retaining the supplied origin.
+    pub fn read_bytes_in(bytes: &[u8], allocator: A) -> Result<Self, InvalidMessage> {
+        let mut reader = Reader::init(bytes);
+        Ok(Self {
+            value: RetainedCodec::read_in(&mut reader, allocator)?,
+        })
+    }
+    /// Existing integration-owner oracle: ordinary reference scratch is
+    /// explicit here and is never used by the product serialization path.
+    pub fn check_seeded_order_reference(&self) -> Result<(), AllocError> {
+        let mut value = self.value.try_clone_in(Global)?;
+        let all = ClientExtensions::<Global>::ALL_EXTENSIONS;
+        for (index, typ) in all.iter().enumerate() {
+            assert!(
+                !all[index + 1..].contains(typ),
+                "extension owner has duplicates"
+            );
+        }
+        let used = value.extensions.collect_used();
+        assert!(used.len() <= all.len());
+        for (index, typ) in used.iter().enumerate() {
+            assert!(all.contains(typ));
+            assert!(!used[index + 1..].contains(typ));
+        }
+        for seed in [0, 1, 0x1234, u16::MAX] {
+            for contiguous in [false, true] {
+                let ext = &mut value.extensions;
+                ext.order_seed = seed;
+                ext.contiguous_extensions.clear();
+                if contiguous {
+                    for typ in [
+                        ExtensionType::SignatureAlgorithms,
+                        ExtensionType::EllipticCurves,
+                    ] {
+                        if used.contains(&typ) {
+                            ext.contiguous_extensions.push(typ);
+                        }
+                    }
+                }
+                // Independent original stable cached-sort rule, restricted to
+                // this ordinary test reference; never selected by an encoder.
+                let mut reference = ext.collect_used();
+                reference.retain(|typ| {
+                    !(matches!(
+                        typ,
+                        ExtensionType::PreSharedKey
+                            | ExtensionType::EncryptedClientHello
+                            | ExtensionType::EncryptedClientHelloOuterExtensions
+                    ) || ext.contiguous_extensions.contains(typ))
+                });
+                reference.sort_by_cached_key(|typ| {
+                    low_quality_integer_hash(((seed as u32) << 16) | u32::from(u16::from(*typ)))
+                });
+                reference.extend(&ext.contiguous_extensions);
+                if ext.encrypted_client_hello_outer.is_some() {
+                    reference.push(ExtensionType::EncryptedClientHelloOuterExtensions);
+                }
+                if ext.encrypted_client_hello.is_some() {
+                    reference.push(ExtensionType::EncryptedClientHello);
+                }
+                if ext.preshared_key_offer.is_some() {
+                    reference.push(ExtensionType::PreSharedKey);
+                }
+                assert_eq!(ext.encoding_order().collect::<Vec<_>>(), reference);
+                let mut expected = Vec::new();
+                if !reference.is_empty() {
+                    let body = LengthPrefixedBuffer::new(ListLength::U16, &mut expected);
+                    for typ in reference {
+                        ext.encode_one(typ, body.buf);
+                    }
+                }
+                let mut actual = Vec::new();
+                ext.encode_retained(&mut actual);
+                assert_eq!(actual, expected, "seeded extension bytes/order changed");
+            }
+        }
+        Ok(())
+    }
+    /// Encode the retained fields with the existing TLS codec.
+    pub fn encode_to(&self, bytes: &mut impl codec::EncodeOutput) {
+        self.value.encode_retained(bytes);
+    }
+    /// Encode the existing ECH inner form with a virtual compressed-extension view.
+    pub fn encode_inner_to(&self, compressed: &[u16], bytes: &mut impl codec::EncodeOutput) {
+        self.value.payload_encode(
+            bytes,
+            Encoding::EchInnerHello {
+                to_compress: compressed
+                    .iter()
+                    .copied()
+                    .map(ExtensionType::from)
+                    .collect(),
+            },
+        );
+    }
+    /// Fallibly copy the complete live field graph into the supplied origin.
+    pub fn try_clone_in<B: Allocator + Clone>(
+        &self,
+        allocator: B,
+    ) -> Result<RetainedClientHello<B>, AllocError> {
+        Ok(RetainedClientHello {
+            value: self.value.try_clone_in(allocator)?,
+        })
+    }
+}
