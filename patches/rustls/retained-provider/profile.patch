+//! Structural integration oracle for the actual retained-state slot/factory.
+//! The probe carries no TLS keys, authority, or negotiated connection metadata.
+use alloc::boxed::Box;
+use core::alloc::{Allocator, Layout};
+use core::sync::atomic::{AtomicUsize, Ordering};
+
+use crate::common_state::{
+    try_state_in, try_state_slot_in, CommonState, Context, ErasedState, Side, State, StateBox,
+    StateDisposition, StateSlot,
+};
+use crate::conn::kernel::{Direction, KernelContext, KernelState};
+use crate::msgs::base::Payload;
+use crate::msgs::handshake::NewSessionTicketPayloadTls13;
+use crate::msgs::message::{Message, MessagePayload};
+use crate::sync::Arc;
+use crate::{
+    ConnectionCommon, ConnectionTrafficSecrets, Error, ProtocolVersion, RetainedAllocator,
+};
+
+/// Fixed observation metadata belongs to the integration harness, outside measured grants.
+#[derive(Default)]
+pub struct Counters {
+    normalized: AtomicUsize,
+    dropped: AtomicUsize,
+}
+impl Counters {
+    /// Number of owned normalizations after successful slot admission.
+    pub fn normalized(&self) -> usize {
+        self.normalized.load(Ordering::SeqCst)
+    }
+    /// Number of concrete values dropped, including refused input values.
+    pub fn dropped(&self) -> usize {
+        self.dropped.load(Ordering::SeqCst)
+    }
+}
+
+struct ProbeState {
+    counters: Arc<Counters>,
+    generation: usize,
+}
+impl Drop for ProbeState {
+    fn drop(&mut self) {
+        self.counters.dropped.fetch_add(1, Ordering::SeqCst);
+    }
+}
+struct BorrowedProbe<'a> {
+    normalized: &'a AtomicUsize,
+    value: ProbeState,
+}
+#[derive(Clone, Copy)]
+enum Action {
+    Stay,
+    Next,
+    Error,
+}
+impl State<Action> for BorrowedProbe<'_> {
+    type Owned = ProbeState;
+    fn handle<'m>(
+        self,
+        _: &mut Context<'_, Action>,
+        _: Message<'m>,
+    ) -> Result<StateDisposition<Self, Action>, Error>
+    where
+        Self: 'm,
+    {
+        Err(Error::HandshakeNotComplete)
+    }
+    fn into_owned(self) -> Self::Owned {
+        self.normalized.fetch_add(1, Ordering::SeqCst);
+        self.value
+    }
+}
+impl State<Action> for ProbeState {
+    type Owned = Self;
+    fn handle<'m>(
+        self,
+        cx: &mut Context<'_, Action>,
+        _: Message<'m>,
+    ) -> Result<StateDisposition<Self, Action>, Error>
+    where
+        Self: 'm,
+    {
+        match *cx.data {
+            Action::Stay => Ok(StateDisposition::Stay(self)),
+            Action::Next => {
+                let next = ProbeState {
+                    counters: self.counters.clone(),
+                    generation: self.generation + 1,
+                };
+                try_state_in(next, cx.common.message_allocator.clone()).map(StateDisposition::Next)
+            }
+            Action::Error => Err(Error::HandshakeNotComplete),
+        }
+    }
+    fn into_owned(self) -> Self::Owned {
+        self
+    }
+    fn kernel_state(&mut self) -> Option<&mut dyn KernelState> {
+        Some(self)
+    }
+}
+impl KernelState for ProbeState {
+    fn update_secrets(&mut self, _: Direction) -> Result<ConnectionTrafficSecrets, Error> {
+        Err(Error::HandshakeNotComplete)
+    }
+    fn handle_new_session_ticket(
+        &mut self,
+        _: &mut KernelContext<'_>,
+        _: &NewSessionTicketPayloadTls13,
+    ) -> Result<(), Error> {
+        Err(Error::HandshakeNotComplete)
+    }
+}
+fn message() -> Message<'static> {
+    Message {
+        version: ProtocolVersion::TLSv1_3,
+        payload: MessagePayload::ApplicationData(Payload::Borrowed(&[])),
+    }
+}
+
+/// Opaque probe of the same concrete slot and pre-normalization factory as live states.
+pub struct SlotProbe<A: Allocator> {
+    slot: Box<StateSlot<ProbeState>, A>,
+}
+impl<A: Allocator> SlotProbe<A> {
+    /// Exact concrete layout requested by the real slot factory.
+    pub fn layout() -> Layout {
+        Layout::new::<StateSlot<ProbeState>>()
+    }
+    /// Admit the actual slot before normalizing a borrowed input.
+    pub fn try_new_in(allocator: A, counters: &Arc<Counters>) -> Result<Self, Error> {
+        let value = BorrowedProbe {
+            normalized: &counters.normalized,
+            value: ProbeState {
+                counters: counters.clone(),
+                generation: 0,
+            },
+        };
+        try_state_slot_in(value, allocator).map(|slot| Self { slot })
+    }
+    /// Read-only identity of the same live backing; exposes no inner state.
+    pub fn allocation(&self) -> (usize, Layout) {
+        (
+            core::ptr::from_ref(&*self.slot) as usize,
+            Layout::for_value(&*self.slot),
+        )
+    }
+    /// Dispatch Stay through the actual slot and retain its original allocation.
+    pub fn stay(mut self) -> Result<Self, Error> {
+        let mut common = CommonState::new(Side::Server);
+        let mut action = Action::Stay;
+        let mut cx = Context {
+            common: &mut common,
+            data: &mut action,
+            sendable_plaintext: None,
+        };
+        if self.slot.handle(&mut cx, message())?.is_some() {
+            return Err(Error::HandshakeNotComplete);
+        }
+        Ok(self)
+    }
+    /// Dispatch an error through the actual slot, consuming its concrete value.
+    pub fn fail(mut self) -> Result<(), Error> {
+        let mut common = CommonState::new(Side::Server);
+        let mut action = Action::Error;
+        let mut cx = Context {
+            common: &mut common,
+            data: &mut action,
+            sendable_plaintext: None,
+        };
+        self.slot.handle(&mut cx, message()).map(|_| ())
+    }
+}
+impl SlotProbe<RetainedAllocator> {
+    /// Reuse the same box in the live erased carrier. No normalization or allocation.
+    pub fn into_retained(self, allocator: RetainedAllocator) -> RetainedProbe {
+        RetainedProbe {
+            state: StateBox::from_slot(self.slot),
+            allocator,
+        }
+    }
+}
+/// Actual erased state handling, with the selected allocator and its original owner.
+pub struct RetainedProbe {
+    state: StateBox<Action>,
+    allocator: RetainedAllocator,
+}
+impl RetainedProbe {
+    /// Read-only identity of the same live backing; exposes no inner state.
+    pub fn allocation(&self) -> (usize, Layout) {
+        self.state.allocation().unwrap()
+    }
+    fn advance(self, mut action: Action) -> Result<Self, Error> {
+        let mut common = CommonState::new(Side::Server);
+        common.message_allocator = self.allocator.clone();
+        let mut cx = Context {
+            common: &mut common,
+            data: &mut action,
+            sendable_plaintext: None,
+        };
+        self.state.handle(&mut cx, message()).map(|state| Self {
+            state,
+            allocator: self.allocator,
+        })
+    }
+    /// Dispatch Stay through the real erased carrier without new backing.
+    pub fn stay(self) -> Result<Self, Error> {
+        self.advance(Action::Stay)
+    }
+    /// Dispatch Next, admitting the next slot using the same connection origin.
+    pub fn next(self) -> Result<Self, Error> {
+        self.advance(Action::Next)
+    }
+    /// Dispatch an error and consume the complete carrier exactly once.
+    pub fn fail(self) -> Result<Self, Error> {
+        self.advance(Action::Error)
+    }
+    /// The real external-state conversion retains the very same carrier.
+    pub fn into_external(self) -> Result<Self, Error> {
+        self.state.into_external_state().map(|state| Self {
+            state,
+            allocator: self.allocator,
+        })
+    }
+}
+/// Read-only state allocation identity for an actual connection's integration checks.
+pub fn connection_allocation<Data>(connection: &ConnectionCommon<Data>) -> Option<(usize, Layout)> {
+    connection.core.state.as_ref().ok()?.allocation()
+}
