+pub(crate) fn try_own_parsed_box<A: core::alloc::Allocator + Clone>(
+    parsed: alloc::boxed::Box<HandshakeMessagePayload<'_>, A>,
+) -> Result<alloc::boxed::Box<HandshakeMessagePayload<'static>, A>, InvalidMessage> {
+    // Admit the actual final owner before normalization; both boxes are paid
+    // during this bounded overlap. The placeholder has no child backing.
+    let mut owned = try_parsed_box_in(
+        HandshakeMessagePayload(HandshakePayload::HelloRequest),
+        alloc::boxed::Box::allocator(&parsed).clone(),
+    )?;
+    *owned = (*parsed).try_into_owned()?;
+    Ok(owned)
+}
