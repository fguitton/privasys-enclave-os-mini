+            offset: 0,
+            tls13,
+            closed,
+            encrypt,
+            close: false,
+            refresh: false,
+        }
+    }
+    fn select<'a>(&mut self, message: OutboundPlainMessage<'a>) -> Option<PlannedRecord<'a>> {
+        if !self.encrypt {
