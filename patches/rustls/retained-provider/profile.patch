+// The borrowed wire parse and its original trailing-data check precede the
+// fallible fixed owner. Normalization follows admission of that final owner.
+fn read_server_extensions_in<'a, 'owned, A: Allocator>(
+    input: &mut Reader<'a>,
+    allocator: A,
+    allow_absent: bool,
+    label: &'static str,
+    normalize: impl FnOnce(ServerExtensions<'a>) -> ServerExtensions<'owned>,
+) -> Result<Box<ServerExtensions<'owned>, A>, InvalidMessage> {
+    let parsed = if allow_absent && !input.any_left() {
+        ServerExtensions::default()
+    } else {
+        ServerExtensions::read(input)?
+    };
+    input.expect_empty(label)?;
+    let mut storage = Box::try_new_in(ServerExtensions::default(), allocator)
+        .map_err(|_| InvalidMessage::AllocationFailed)?;
+    *storage = normalize(parsed);
+    Ok(storage)
+}
