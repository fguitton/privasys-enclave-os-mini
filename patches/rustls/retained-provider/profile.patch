+/// The existing DER wrapper with caller-owned fallible backing. The header
+/// rules and encoded bytes match `asn1_wrap`; every growth is admitted first.
+pub(crate) fn try_asn1_wrap_in<A: core::alloc::Allocator>(
+    tag: u8,
+    bytes_a: &[u8],
+    bytes_b: &[u8],
+    allocator: A,
+) -> Result<Vec<u8, A>, core::alloc::AllocError> {
+    let len = bytes_a
+        .len()
+        .checked_add(bytes_b.len())
+        .ok_or(core::alloc::AllocError)?;
+    let size = len.to_be_bytes();
+    let leading = size
+        .iter()
+        .position(|&byte| byte != 0)
+        .unwrap_or(size.len());
+    let encoded = if len <= 0x7f { 0 } else { size.len() - leading };
+    let capacity = len
+        .checked_add(2)
+        .and_then(|n| n.checked_add(encoded))
+        .ok_or(core::alloc::AllocError)?;
+    let mut result = Vec::new_in(allocator);
+    result
+        .try_reserve_exact(capacity)
+        .map_err(|_| core::alloc::AllocError)?;
+    result.push(tag);
+    if encoded == 0 {
+        result.push(len as u8);
+    } else {
+        result.push(0x80 + encoded as u8);
+        result.extend_from_slice(&size[leading..]);
+    }
+    result.extend_from_slice(bytes_a);
+    result.extend_from_slice(bytes_b);
+    Ok(result)
+}
+
+pub(crate) const DER_SEQUENCE_TAG: u8 = 0x30;
+pub(crate) const DER_BIT_STRING_TAG: u8 = 0x03;
