+impl<A: Allocator + Clone> PresharedKeyOffer<A> {
+    pub(crate) fn try_new_in(
+        identity: &[u8],
+        age: u32,
+        binder_len: usize,
+        allocator: A,
+    ) -> Result<Self, AllocError> {
+        let identity = PresharedKeyIdentity {
+            identity: PayloadU16::from_vec_in(super::retained::copy_bytes_in(
+                identity,
+                allocator.clone(),
+            )?),
+            obfuscated_ticket_age: age,
+        };
+        let binder = PresharedKeyBinder(PayloadU8::from_vec_in(super::retained::zero_bytes_in(
+            binder_len,
+            allocator.clone(),
+        )?));
+        Ok(Self {
+            identities: super::retained::collect_in([identity], allocator.clone())?,
+            binders: super::retained::collect_in([binder], allocator)?,
+        })
+    }
+}
