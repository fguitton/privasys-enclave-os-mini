+//! Fallible allocator-bearing ownership used by the current ClientHello decoder.
+//! The allocator is a value supplied by the connection, never ambient state.
+use alloc::vec::Vec;
+use core::alloc::{AllocError, Allocator};
+use core::fmt::Debug;
+
+use super::codec::{Codec, Reader, TlsListElement};
+use crate::error::InvalidMessage;
+
+pub(crate) trait RetainedEncode {
+    fn encode_retained(&self, bytes: &mut impl crate::msgs::codec::EncodeOutput);
+}
+
+pub(crate) trait RetainedCodec<'a, A: Allocator + Clone>:
+    Debug + RetainedEncode + Sized
+{
+    fn read_in(reader: &mut Reader<'a>, allocator: A) -> Result<Self, InvalidMessage>;
+}
+
+pub(crate) trait TryCloneIn<A: Allocator + Clone>: Sized {
+    type Retained;
+    fn try_clone_in(&self, allocator: A) -> Result<Self::Retained, AllocError>;
+}
+
+macro_rules! fixed {
+    ($($ty:ty),+ $(,)?) => {$(
+        impl RetainedEncode for $ty {
+            fn encode_retained(&self, bytes: &mut impl crate::msgs::codec::EncodeOutput) { self.encode(bytes); }
+        }
+        impl<'a, A: Allocator + Clone> RetainedCodec<'a, A> for $ty {
+            fn read_in(reader: &mut Reader<'a>, _: A) -> Result<Self, InvalidMessage> {
+                <$ty as Codec>::read(reader)
+            }
+        }
+        impl<A: Allocator + Clone> TryCloneIn<A> for $ty {
+            type Retained = Self;
+            fn try_clone_in(&self, _: A) -> Result<Self::Retained, AllocError> { Ok(*self) }
+        }
+    )+};
+}
+fixed!(
+    (),
+    u8,
+    u16,
+    u32,
+    u64,
+    crate::enums::CipherSuite,
+    crate::enums::ProtocolVersion,
+    crate::enums::SignatureScheme,
+    crate::enums::CertificateType,
+    super::enums::ClientCertificateType,
+    crate::enums::CertificateCompressionAlgorithm,
+    super::enums::Compression,
+    super::enums::NamedGroup,
+    super::enums::ExtensionType,
+    super::enums::ECPointFormat,
+    super::enums::PskKeyExchangeMode,
+    super::handshake::Random,
+    super::handshake::SessionId,
+    super::handshake::HpkeSymmetricCipherSuite,
+    super::handshake::SupportedEcPointFormats,
+    super::handshake::SupportedProtocolVersions,
+    super::handshake::PskKeyExchangeModes,
+    super::handshake::ClientTicketRequest,
+);
+
+impl<'a, T, A> RetainedCodec<'a, A> for Vec<T, A>
+where
+    T: RetainedCodec<'a, A> + TlsListElement,
+    A: Allocator + Clone,
+{
+    fn read_in(reader: &mut Reader<'a>, allocator: A) -> Result<Self, InvalidMessage> {
+        let length = T::SIZE_LEN.read(reader)?;
+        let mut sub = reader.sub(length)?;
+        let mut result = Self::new_in(allocator.clone());
+        while sub.any_left() {
+            let item = T::read_in(&mut sub, allocator.clone())?;
+            result
+                .try_reserve(1)
+                .map_err(|_| InvalidMessage::AllocationFailed)?;
+            result.push(item);
+        }
+        Ok(result)
+    }
+}
+
+impl<T: TryCloneIn<A>, A: Allocator + Clone, B: Allocator + Clone> TryCloneIn<A> for Vec<T, B> {
+    type Retained = Vec<T::Retained, A>;
+    fn try_clone_in(&self, allocator: A) -> Result<Self::Retained, AllocError> {
+        let mut result = Vec::new_in(allocator.clone());
+        result
+            .try_reserve_exact(self.len())
+            .map_err(|_| AllocError)?;
+        for item in self {
+            result.push(item.try_clone_in(allocator.clone())?);
+        }
+        Ok(result)
+    }
+}
+
+impl<T: TryCloneIn<A>, A: Allocator + Clone> TryCloneIn<A> for Option<T> {
+    type Retained = Option<T::Retained>;
+    fn try_clone_in(&self, allocator: A) -> Result<Self::Retained, AllocError> {
+        self.as_ref()
+            .map(|item| item.try_clone_in(allocator))
+            .transpose()
+    }
+}
+
+pub(crate) fn copy_bytes_in<A: Allocator + Clone>(
+    bytes: &[u8],
+    allocator: A,
+) -> Result<Vec<u8, A>, AllocError> {
+    let mut result = Vec::new_in(allocator);
+    result
+        .try_reserve_exact(bytes.len())
+        .map_err(|_| AllocError)?;
+    result.extend_from_slice(bytes);
+    Ok(result)
+}
+
+impl<T: RetainedEncode + TlsListElement, A: Allocator + Clone> RetainedEncode for Vec<T, A> {
+    fn encode_retained(&self, bytes: &mut impl crate::msgs::codec::EncodeOutput) {
+        let body = super::codec::LengthPrefixedBuffer::new(T::SIZE_LEN, bytes);
+        for item in self {
+            item.encode_retained(body.buf);
+        }
+    }
+}
+impl<T: TryCloneIn<A>, A: Allocator + Clone, B: Allocator + Clone> TryCloneIn<A>
+    for alloc::boxed::Box<T, B>
+{
+    type Retained = alloc::boxed::Box<T::Retained, A>;
+    fn try_clone_in(&self, allocator: A) -> Result<Self::Retained, AllocError> {
+        alloc::boxed::Box::try_new_in((**self).try_clone_in(allocator.clone())?, allocator)
+    }
+}
+
+/// Fallible collection of already produced values; never stages a Global Vec.
+pub(crate) fn collect_in<T, A: Allocator + Clone>(
+    values: impl IntoIterator<Item = T>,
+    allocator: A,
+) -> Result<Vec<T, A>, AllocError> {
+    let mut output = Vec::new_in(allocator);
+    for value in values {
+        output.try_reserve(1).map_err(|_| AllocError)?;
+        output.push(value);
+    }
+    Ok(output)
+}
+pub(crate) fn clone_slice_in<T: TryCloneIn<A>, A: Allocator + Clone>(
+    values: &[T],
+    allocator: A,
+) -> Result<Vec<T::Retained, A>, AllocError> {
+    let mut output = Vec::new_in(allocator.clone());
+    output
+        .try_reserve_exact(values.len())
+        .map_err(|_| AllocError)?;
+    for value in values {
+        output.push(value.try_clone_in(allocator.clone())?);
+    }
+    Ok(output)
+}
+pub(crate) fn zero_bytes_in<A: Allocator + Clone>(
+    len: usize,
+    allocator: A,
+) -> Result<Vec<u8, A>, AllocError> {
+    let mut output = Vec::new_in(allocator);
+    output.try_reserve_exact(len).map_err(|_| AllocError)?;
+    output.resize(len, 0);
+    Ok(output)
+}
