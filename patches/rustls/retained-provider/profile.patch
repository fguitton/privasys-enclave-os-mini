+fn observe(common: &CommonState) -> Snapshot {
+    Snapshot {
+        sequence: common.record_layer.write_seq(),
+        active: common.record_layer.is_encrypting(),
+        queued_bytes: common.sendable_tls.len(),
+        pending_bytes: common
+            .queued_key_update_message
+            .as_ref()
+            .map_or(0, |bytes| bytes.len()),
