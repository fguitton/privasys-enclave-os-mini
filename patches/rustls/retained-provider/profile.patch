+/// Staged record backing; refusal leaves the live queue untouched.
+pub(crate) struct PreparedAppend<A: Allocator + Clone> {
+    records: PreparedRecords<A>,
+    remaining: usize,
+    replaces_queue: bool,
+}
+
+enum PreparedRecords<A: Allocator + Clone> {
+    Inline(Option<Vec<u8, A>>),
+    Deque(VecDeque<Vec<u8, A>, A>),
+}
+
+impl<A: Allocator + Clone> PreparedRecords<A> {
+    fn pop(&mut self) -> Option<Vec<u8, A>> {
+        match self {
+            Self::Inline(bytes) => bytes.take(),
+            Self::Deque(chunks) => chunks.pop_front(),
+        }
+    }
+
+    fn push(&mut self, bytes: Vec<u8, A>) {
+        match self {
+            Self::Inline(slot) => {
+                debug_assert!(slot.is_none());
+                *slot = Some(bytes);
+            }
+            Self::Deque(chunks) => chunks.push_back(bytes),
+        }
+    }
+}
+
+impl<A: Allocator + Clone> PreparedAppend<A> {
+    pub(crate) fn next_buffer(&mut self) -> Vec<u8, A> {
+        debug_assert_ne!(self.remaining, 0);
+        self.remaining -= 1;
+        self.records.pop().expect("one admitted buffer per record")
+    }
+
+    pub(crate) fn finish_buffer(&mut self, bytes: Vec<u8, A>) {
+        // Reuse the inline slot or just-removed descriptor without allocation.
+        self.records.push(bytes);
+    }
+}
