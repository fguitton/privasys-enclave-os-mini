+/// Opaque access to the live transcript buffer for the existing allocation owner.
+pub struct RetainedHandshakeBuffer<A: Allocator + Clone>(HandshakeHashBuffer<A>);
+impl<A: Allocator + Clone> core::fmt::Debug for RetainedHandshakeBuffer<A> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("RetainedHandshakeBuffer")
+            .field("bytes", &self.0.buffer.len())
+            .finish()
+    }
+}
+impl<A: Allocator + Clone> RetainedHandshakeBuffer<A> {
+    /// Start the same buffer with the explicit retained origin.
+    pub fn new_in(allocator: A, context_allocator: crate::RetainedAllocator) -> Self {
+        Self(HandshakeHashBuffer::new_in(allocator, context_allocator))
+    }
+    /// Retain all later client-auth transcript bytes.
+    pub fn retain_client_auth(&mut self) {
+        self.0.set_client_auth_enabled();
+    }
+    /// Grow physically before changing the live transcript.
+    pub fn try_add(&mut self, bytes: &[u8]) -> Result<(), Error> {
+        self.0.add_raw(bytes)
+    }
+    /// Borrow the current canonical transcript bytes.
+    pub fn bytes(&self) -> &[u8] {
+        &self.0.buffer
+    }
+    /// Fallibly copy the same live transcript under its original origin.
+    pub fn try_clone(&self) -> Result<Self, Error> {
+        self.0.try_clone().map(Self)
+    }
+    /// Move the retained bytes into the existing selected hash state.
+    pub fn start_hash(
+        self,
+        provider: &'static dyn hash::Hash,
+    ) -> Result<RetainedHandshakeHash<A>, Error> {
+        self.0.start_hash(provider).map(RetainedHandshakeHash)
+    }
+}
+/// Opaque access to the live running transcript and retained auth bytes.
+pub struct RetainedHandshakeHash<A: Allocator + Clone>(HandshakeHash<A>);
+impl<A: Allocator + Clone> core::fmt::Debug for RetainedHandshakeHash<A> {
+    fn fmt(&self, f: &mut core::fmt::Formatter<'_>) -> core::fmt::Result {
+        f.debug_struct("RetainedHandshakeHash")
+            .finish_non_exhaustive()
+    }
+}
+impl<A: Allocator + Clone> RetainedHandshakeHash<A> {
+    /// Append after complete byte admission, before hash mutation.
+    pub fn try_add(&mut self, bytes: &[u8]) -> Result<(), Error> {
+        self.0.add(bytes)
+    }
+    /// Read the selected provider's hash without allocating a context copy.
+    pub fn current_hash(&self) -> hash::Output {
+        self.0.current_hash()
+    }
+    /// Borrow exactly the retained client-auth bytes.
+    pub fn client_auth_bytes(&self) -> Option<&[u8]> {
+        self.0.client_auth.as_deref()
+    }
+    /// Fallibly prepare the buffer before the existing crypto context fork.
+    pub fn try_clone(&self) -> Result<Self, Error> {
+        self.0.try_clone().map(Self)
+    }
+    /// Perform the existing HRR hash rollup after byte admission.
+    pub fn try_rollup(&mut self) -> Result<(), Error> {
+        self.0.rollup_for_hrr()
+    }
+    /// Transfer the current HRR preimage into the same origin's live buffer.
+    pub fn try_into_hrr(self) -> Result<RetainedHandshakeBuffer<A>, Error> {
+        self.0.into_hrr_buffer().map(RetainedHandshakeBuffer)
+    }
+}
