+#[doc(hidden)]
+pub fn server_extensions_parser_probe<A: Allocator>(
+    allocator: A,
+    server_hello: bool,
+    trailing: bool,
+) -> Result<(), InvalidMessage> {
+    let bytes = [0, 0, 0];
+    let mut input = Reader::init(if trailing { &bytes } else { &bytes[..2] });
+    if server_hello {
+        drop(read_server_extensions_in(
+            &mut input,
+            allocator,
+            true,
+            "ServerHelloPayload",
+            ServerExtensions::into_owned,
+        )?);
+    } else {
+        drop(read_server_extensions_in(
+            &mut input,
+            allocator,
+            false,
+            "HandshakeMessagePayload",
+            |parsed| parsed,
+        )?);
+    }
+    Ok(())
+}
