+/// Inline TLS1.3 KeyUpdate serialization using the current handshake codec.
+/// The body is the enum's u8 wire representation after the shared handshake header.
+#[derive(Debug)]
+pub(crate) struct KeyUpdateMessage {
+    bytes: [u8; HandshakeMessagePayload::<'static>::HEADER_LEN + size_of::<u8>()],
+    used: usize,
+}
+
+impl KeyUpdateMessage {
+    pub(crate) fn new(request: KeyUpdateRequest) -> Self {
+        let mut message = Self {
+            bytes: [0; HandshakeMessagePayload::<'static>::HEADER_LEN + size_of::<u8>()],
+            used: 0,
+        };
+        let payload = HandshakeMessagePayload(HandshakePayload::KeyUpdate(request));
+        let measured = payload.encoded_length().expect("fixed KeyUpdate codec");
+        assert_eq!(measured, message.bytes.len(), "KeyUpdate codec width");
+        payload.encode(&mut message);
+        assert_eq!(message.used, message.bytes.len());
+        message
+    }
+
+    pub(crate) fn encoded(&self) -> &[u8] {
+        &self.bytes
+    }
+
+    pub(crate) fn borrow_outbound(&self) -> OutboundPlainMessage<'_> {
+        OutboundPlainMessage {
+            typ: ContentType::Handshake,
+            version: ProtocolVersion::TLSv1_3,
+            payload: self.encoded().into(),
+        }
+    }
+}
+
+impl EncodeOutput for KeyUpdateMessage {
+    fn len(&self) -> usize {
+        self.used
+    }
+
+    fn push(&mut self, byte: u8) {
+        self.extend_from_slice(&[byte]);
+    }
+
+    fn extend_from_slice(&mut self, bytes: &[u8]) {
+        let end = self.used.checked_add(bytes.len()).unwrap();
+        self.bytes[self.used..end].copy_from_slice(bytes);
+        self.used = end;
+    }
+
+    fn patch(&mut self, offset: usize, bytes: &[u8]) {
+        let end = offset.checked_add(bytes.len()).unwrap();
+        assert!(end <= self.used);
+        self.bytes[offset..end].copy_from_slice(bytes);
+    }
+}
