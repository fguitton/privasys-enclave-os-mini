+        let mut cert_decompressors = Vec::new();
+        let compressors = compress::default_cert_compressors();
+        let decompressors = compress::default_cert_decompressors();
+        cert_compressors
+            .try_reserve_exact(compressors.len())
+            .map_err(|_| ServerConfigAllocationError::Allocation)?;
+        cert_decompressors
+            .try_reserve_exact(decompressors.len())
+            .map_err(|_| ServerConfigAllocationError::Allocation)?;
