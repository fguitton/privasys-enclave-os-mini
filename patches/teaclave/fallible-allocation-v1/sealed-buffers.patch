+    fn write_header(
+        output: &mut [u8],
+        key_request: &KeyRequest,
+        plaintext_len: u32,
+        payload_len: u32,
+        tag: [u8; SEAL_TAG_SIZE],
+    ) {
+        let mut header = CSealedData::default();
+        header.key_request = *key_request;
+        header.plaintext_offset = plaintext_len;
+        header.aes_data.payload_size = payload_len;
+        header.aes_data.payload_tag = tag;
+        // The C format's explicit reserved fields account for every
+        // header byte; no implicit padding is copied into the wire.
+        const _: () = assert!(
+            mem::size_of::<KeyRequest>()
+                == mem::size_of::<KeyName>()
+                    + mem::size_of::<KeyPolicy>()
+                    + mem::size_of::<u16>() * 3
+                    + mem::size_of::<u32>()
+                    + mem::size_of::<sgx_types::types::CpuSvn>()
+                    + mem::size_of::<Attributes>()
+                    + mem::size_of::<KeyId>()
+                    + sgx_types::types::KEY_REQUEST_RESERVED2_BYTES
+        );
+        const _: () = assert!(
+            mem::offset_of!(KeyRequest, reserved2) + sgx_types::types::KEY_REQUEST_RESERVED2_BYTES
+                == mem::size_of::<KeyRequest>()
+        );
+        const _: () = assert!(
+            mem::size_of::<CSealedData>()
+                == mem::size_of::<KeyRequest>()
+                    + mem::size_of::<u32>()
+                    + mem::size_of::<[u8; 12]>()
+                    + mem::size_of::<sgx_types::types::CAesGcmData>()
+        );
+        // SAFETY: output is fully initialized, enclaved, and checked
+        // for the complete C header. Supplied storage need not align.
+        unsafe { core::ptr::write_unaligned(output.as_mut_ptr().cast(), header) };
+    }
+
+    /// Validate a borrowed raw buffer without constructing owned children.
+    fn borrowed(raw: &[u8]) -> SgxResult<(CSealedData, &[u8], &[u8])> {
+        ensure!(raw.is_enclave_range(), SgxStatus::InvalidParameter);
+        let header_len = mem::size_of::<CSealedData>();
+        ensure!(raw.len() >= header_len, SgxStatus::InvalidParameter);
+        // Validate the only enum discriminant before reading the C struct.
+        let key_name_offset =
+            mem::offset_of!(CSealedData, key_request) + mem::offset_of!(KeyRequest, key_name);
+        let key_name = u16::from_ne_bytes(
+            raw[key_name_offset..key_name_offset + mem::size_of::<u16>()]
+                .try_into()
+                .map_err(|_| SgxStatus::InvalidParameter)?,
+        );
+        KeyName::try_from(key_name).map_err(|_| SgxStatus::InvalidParameter)?;
+        // SAFETY: the full initialized header is present, its only enum tag is
+        // valid, and unaligned input is read without creating a typed reference.
+        let header: CSealedData = unsafe { core::ptr::read_unaligned(raw.as_ptr().cast()) };
+        ensure!(
+            header.plaintext_offset <= header.aes_data.payload_size,
+            SgxStatus::InvalidParameter
+        );
+        let aad_len = header.aes_data.payload_size - header.plaintext_offset;
+        let raw_len = Self::raw_sealed_data_size(aad_len, header.plaintext_offset)
+            .ok_or(SgxStatus::InvalidParameter)?;
+        ensure!(raw.len() == raw_len as usize, SgxStatus::InvalidParameter);
+        let ciphertext_end = header_len + header.plaintext_offset as usize;
+        Ok((
+            header,
+            &raw[header_len..ciphertext_end],
+            &raw[ciphertext_end..],
+        ))
+    }
+
+    pub fn plaintext_size(raw: &[u8]) -> SgxResult<usize> {
+        Self::borrowed(raw).map(|(_, ciphertext, _)| ciphertext.len())
+    }
+
+    /// Authenticate/decrypt into caller-owned exact storage. AAD remains a
+    /// borrowed authenticated view of the original raw input on success only.
+    pub fn unseal_into<'a>(raw: &'a [u8], plaintext: &mut [u8]) -> SgxResult<&'a [u8]> {
+        let (header, ciphertext, aad) = Self::borrowed(raw)?;
+        ensure!(
+            plaintext.len() == ciphertext.len(),
+            SgxStatus::InvalidParameter
+        );
+        ensure!(plaintext.is_enclave_range(), SgxStatus::InvalidParameter);
+        plaintext.fill(0);
+        Self::decrypt_into(
+            ciphertext,
+            aad,
+            &header.key_request,
+            &header.aes_data.payload_tag,
+            plaintext,
+        )?;
+        Ok(aad)
     }
 
