+        key: &sgx_types::types::Key128bit,
+    ) -> SgxResult<()> {
+        let result = (|| {
+            let mut aes = AesGcm::new(key, Nonce::zeroed(), Aad::from(aad))?;
+            aes.decrypt(ciphertext, plaintext, tag)
+        })();
+        if result.is_err() {
+            plaintext.fill(0);
+        }
+        result
