+    /// Seal directly into an already allocated exact raw-format buffer.
+    /// No Rust-owned ciphertext or AAD intermediate is constructed.
+    pub fn seal_with_key_policy_into(
+        key_policy: KeyPolicy,
+        attribute_mask: Attributes,
+        misc_mask: u32,
+        plaintext: &[u8],
+        aad: Option<&[u8]>,
+        output: &mut [u8],
+    ) -> SgxResult<()> {
+        let aad_len =
+            u32::try_from(aad.map_or(0, <[u8]>::len)).map_err(|_| SgxStatus::InvalidParameter)?;
+        let plaintext_len =
+            u32::try_from(plaintext.len()).map_err(|_| SgxStatus::InvalidParameter)?;
+        let raw_len = Self::raw_sealed_data_size(aad_len, plaintext_len)
+            .ok_or(SgxStatus::InvalidParameter)?;
+        ensure!(
+            output.len() == raw_len as usize,
+            SgxStatus::InvalidParameter
+        );
+        ensure!(output.is_enclave_range(), SgxStatus::InvalidParameter);
+        output.fill(0);
+        let result = Self::with_seal_key_request(
+            key_policy,
+            attribute_mask,
+            misc_mask,
+            plaintext,
+            aad,
+            |key_request, aad| {
+                let header_len = mem::size_of::<CSealedData>();
+                let ciphertext_end = header_len + plaintext.len();
+                let tag = Self::encrypt_into(
+                    plaintext,
+                    aad,
+                    key_request,
+                    &mut output[header_len..ciphertext_end],
+                )?;
+                output[ciphertext_end..].copy_from_slice(aad);
+                Self::write_header(
+                    output,
+                    key_request,
+                    plaintext_len,
+                    plaintext_len + aad_len,
+                    tag,
+                );
+                Ok(())
+            },
+        );
+        if result.is_err() {
+            output.fill(0);
+        }
+        result
+    }
