+impl SealedData<[u8]> {
+    /// Exact current C-format size. This is a geometry query, not authority.
+    pub fn sealed_size(plaintext_len: usize, aad_len: usize) -> SgxResult<usize> {
+        ensure!(
+            (1..u32::MAX as usize).contains(&plaintext_len),
+            SgxStatus::InvalidParameter
+        );
+        let aad_len = u32::try_from(aad_len).map_err(|_| SgxStatus::InvalidParameter)?;
+        let plaintext_len =
+            u32::try_from(plaintext_len).map_err(|_| SgxStatus::InvalidParameter)?;
+        InnerSealedData::raw_sealed_data_size(aad_len, plaintext_len)
+            .map(|length| length as usize)
+            .ok_or(SgxStatus::InvalidParameter)
+    }
+
+    pub fn seal_with_key_policy_into(
+        key_policy: KeyPolicy,
+        attribute_mask: Attributes,
+        misc_mask: u32,
+        data: &[u8],
+        aad: Option<&[u8]>,
+        output: &mut [u8],
+    ) -> SgxResult<()> {
+        InnerSealedData::seal_with_key_policy_into(
+            key_policy,
+            attribute_mask,
+            misc_mask,
+            data,
+            aad,
+            output,
+        )
+    }
+
+    /// Unauthenticated geometry only; successful authentication is still
+    /// required before the supplied plaintext may be published or consumed.
+    pub fn plaintext_size(raw: &[u8]) -> SgxResult<usize> {
+        InnerSealedData::plaintext_size(raw)
+    }
+
+    pub fn unseal_into<'a>(raw: &'a [u8], plaintext: &mut [u8]) -> SgxResult<&'a [u8]> {
+        InnerSealedData::unseal_into(raw, plaintext)
+    }
+}
