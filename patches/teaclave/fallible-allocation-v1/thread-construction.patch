+// Construct one exact boxed C string. Unlike CString::new(Vec), this cannot
+// reserve or shrink through an infallible allocation after admission.
+#[cfg(feature = "thread")]
+fn try_thread_name(name: String) -> io::Result<CString> {
+    assert!(!name.as_bytes().contains(&0), "thread name may not contain interior null bytes");
+    let length = name.len().checked_add(1)
+        .ok_or_else(|| io::Error::from(io::ErrorKind::OutOfMemory))?;
+    let mut storage = Box::<[u8]>::try_new_uninit_slice(length)
+        .map_err(|_| io::Error::from(io::ErrorKind::OutOfMemory))?;
+    for (target, byte) in storage.iter_mut().zip(name.bytes().chain(core::iter::once(0))) {
+        target.write(byte);
+    }
+    // SAFETY: every byte was initialized, there are no interior NULs, and the
+    // final byte is NUL. CStr has the same byte-slice allocation/layout; the
+    // standard Box<CStr> -> CString conversion transfers ownership unchanged.
+    let name = unsafe {
+        let bytes = storage.assume_init();
+        Box::from_raw(Box::into_raw(bytes) as *mut CStr)
+    };
+    Ok(CString::from(name))
+}
