+//! SDK-only opt-in fixed waiter backend. No live legacy backend migration.
+use super::fixed_futex_table::Table;
+use super::ocall::{self, Timeout};
+use core::alloc::{AllocError, Allocator, Layout};
+use sgx_trts::{
+    sync::SpinMutex,
+    tcs::{self, TcsId},
+};
+use sgx_types::error::{
+    errno::{EAGAIN, EINVAL},
+    OsResult,
+};
+type Admission = &'static (dyn Allocator + Send + Sync);
+type Waiters = Table<TcsId, Admission>;
+struct Selection {
+    legacy_used: bool,
+    waiters: Option<Waiters>,
+}
+static SELECTION: SpinMutex<Selection> = SpinMutex::new(Selection {
+    legacy_used: false,
+    waiters: None,
+});
+/// Complete user allocation shape; the chosen allocator owns its own header.
+pub fn required_layout() -> Result<Layout, AllocError> {
+    Waiters::requested_layout(tcs::tcs_max_num())
+}
+/// The allocator must remain live for the enclave process. Refuse switching
+/// after ANY legacy use, so an outstanding old waiter never loses its waker.
+pub fn initialize(allocator: Admission) -> Result<(), AllocError> {
+    let waiters = Waiters::try_new(tcs::tcs_max_num(), allocator)?;
+    let mut selected = SELECTION.lock();
+    if selected.legacy_used || selected.waiters.is_some() {
+        return Err(AllocError);
+    }
+    selected.waiters = Some(waiters);
+    Ok(())
+}
+pub(super) fn wait(
+    key: usize,
+    bucket: usize,
+    expected: u32,
+    bitset: u32,
+    timeout: Option<Timeout>,
+    load: impl FnOnce() -> u32,
+) -> Option<OsResult> {
+    let current = tcs::current().id();
+    let ticket = {
+        let mut selected = SELECTION.lock();
+        let Some(waiters) = selected.waiters.as_mut() else {
+            selected.legacy_used = true;
+            return None;
+        };
+        if load() != expected {
+            return Some(Err(EAGAIN));
+        }
+        match waiters.register(current, key, bucket, bitset) {
+            Ok(ticket) => ticket,
+            Err(_) => return Some(Err(EAGAIN)),
+        }
+    };
+    let result = loop {
+        let woken = {
+            let selected = SELECTION.lock();
+            selected.waiters.as_ref().unwrap().woken(ticket)
+        };
+        match woken {
+            Ok(true) => break Ok(()),
+            Ok(false) => (),
+            Err(_) => break Err(EINVAL),
+        }
+        if let Err(error) = ocall::thread_wait_event_ex(current, timeout) {
+            break Err(error);
+        }
+    };
+    // Acknowledgement under the same lock occurs on EVERY return, including
+    // timeout after requeue and unusual host errors. Slot lifetime is independent
+    // of its old key and no allocating Arc is needed for the waiting alias.
+    let mut selected = SELECTION.lock();
+    if selected.waiters.as_mut().unwrap().finish(ticket).is_err() {
+        return Some(Err(EINVAL));
+    }
+    Some(result)
+}
+pub(super) fn wake(key: usize, bitset: u32, maximum: usize) -> Option<OsResult<usize>> {
+    let mut selected = SELECTION.lock();
+    let Some(waiters) = selected.waiters.as_mut() else {
+        selected.legacy_used = true;
+        return None;
+    };
+    Some(Ok(waiters.wake(key, bitset, maximum, |tcs| {
+        let _ = ocall::thread_set_event(tcs);
+    })))
+}
+pub(super) fn requeue(
+    old: usize,
+    new: usize,
+    new_bucket: usize,
+    max_wake: usize,
+    max_requeue: usize,
+    expected: Option<u32>,
+    load: impl FnOnce() -> u32,
+) -> Option<OsResult<(usize, usize)>> {
+    let mut selected = SELECTION.lock();
+    let Some(waiters) = selected.waiters.as_mut() else {
+        selected.legacy_used = true;
+        return None;
+    };
+    if expected.is_some_and(|expected| load() != expected) {
+        return Some(Err(EAGAIN));
+    }
+    let wakes = waiters.wake(old, u32::MAX, max_wake, |tcs| {
+        let _ = ocall::thread_set_event(tcs);
+    });
+    let moved = waiters.requeue(old, new, new_bucket, max_requeue);
+    Some(Ok((wakes, moved)))
+}
