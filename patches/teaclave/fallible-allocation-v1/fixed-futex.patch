+//! Fixed waiter metadata: one slot per actual measured TCS, no CPU bucket array.
+//! SDK adaptation must supply sgx_trts::tcs::tcs_max_num(), not a copied profile.
+use alloc::boxed::Box;
+use core::alloc::{AllocError, Allocator, Layout};
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum State {
+    Vacant,
+    Waiting,
+    Woken,
+}
+struct Slot<T> {
+    tcs: Option<T>,
+    key: usize,
+    bucket: usize,
+    bitset: u32,
+    generation: u64,
+    state: State,
+    next: Option<usize>,
+}
+impl<T> Slot<T> {
+    fn empty() -> Self {
+        Self {
+            tcs: None,
+            key: 0,
+            bucket: 0,
+            bitset: 0,
+            generation: 0,
+            state: State::Vacant,
+            next: None,
+        }
+    }
+}
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Ticket<T> {
+    index: usize,
+    generation: u64,
+    tcs: T,
+}
+pub struct Table<T: Copy + Eq, A: Allocator> {
+    slots: Box<[Slot<T>], A>,
+    head: Option<usize>,
+    tail: Option<usize>,
+}
+impl<T: Copy + Eq, A: Allocator> Table<T, A> {
+    pub fn requested_layout(measured_tcs: usize) -> Result<Layout, AllocError> {
+        if measured_tcs == 0 {
+            return Err(AllocError);
+        }
+        Layout::array::<Slot<T>>(measured_tcs).map_err(|_| AllocError)
+    }
+    pub fn try_new(measured_tcs: usize, allocator: A) -> Result<Self, AllocError> {
+        Self::requested_layout(measured_tcs)?;
+        let mut slots = Box::<[Slot<T>], A>::try_new_uninit_slice_in(measured_tcs, allocator)?;
+        for slot in slots.iter_mut() {
+            slot.write(Slot::empty());
+        }
+        let slots = unsafe { slots.assume_init() };
+        Ok(Self {
+            slots,
+            head: None,
+            tail: None,
+        })
+    }
+    fn append(&mut self, index: usize) {
+        self.slots[index].next = None;
+        if let Some(tail) = self.tail {
+            self.slots[tail].next = Some(index)
+        } else {
+            self.head = Some(index)
+        }
+        self.tail = Some(index);
+    }
+    fn unlink(&mut self, index: usize) {
+        let mut prior: Option<usize> = None;
+        let mut at = self.head;
+        while let Some(current) = at {
+            if current == index {
+                let next = self.slots[current].next;
+                if let Some(prior) = prior {
+                    self.slots[prior].next = next
+                } else {
+                    self.head = next
+                }
+                if self.tail == Some(current) {
+                    self.tail = prior
+                }
+                self.slots[current].next = None;
+                return;
+            }
+            prior = at;
+            at = self.slots[current].next;
+        }
+    }
+    pub fn register(
+        &mut self,
+        tcs: T,
+        key: usize,
+        bucket: usize,
+        bitset: u32,
+    ) -> Result<Ticket<T>, AllocError> {
+        if self
+            .slots
+            .iter()
+            .any(|s| s.state != State::Vacant && s.tcs == Some(tcs))
+        {
+            return Err(AllocError);
+        }
+        let index = self
+            .slots
+            .iter()
+            .position(|s| s.state == State::Vacant)
+            .ok_or(AllocError)?;
+        let generation = self.slots[index]
+            .generation
+            .checked_add(1)
+            .ok_or(AllocError)?;
+        self.slots[index] = Slot {
+            tcs: Some(tcs),
+            key,
+            bucket,
+            bitset,
+            generation,
+            state: State::Waiting,
+            next: None,
+        };
+        self.append(index);
+        Ok(Ticket {
+            index,
+            generation,
+            tcs,
+        })
+    }
+    fn valid(&self, ticket: Ticket<T>) -> bool {
+        self.slots.get(ticket.index).is_some_and(|s| {
+            s.state != State::Vacant
+                && s.tcs == Some(ticket.tcs)
+                && s.generation == ticket.generation
+        })
+    }
+    pub fn woken(&self, ticket: Ticket<T>) -> Result<bool, AllocError> {
+        if !self.valid(ticket) {
+            return Err(AllocError);
+        }
+        Ok(self.slots[ticket.index].state == State::Woken)
+    }
+    /// Successful wake retains the slot until original waiter acknowledges it;
+    /// no timeout/requeue race can recycle a live waiter's identity.
+    pub fn wake(
+        &mut self,
+        key: usize,
+        bitset: u32,
+        maximum: usize,
+        mut notify: impl FnMut(T),
+    ) -> usize {
+        let mut count = 0;
+        let mut at = self.head;
+        while let Some(index) = at {
+            let next = self.slots[index].next;
+            if count < maximum
+                && self.slots[index].key == key
+                && (self.slots[index].bitset & bitset) != 0
+            {
+                self.unlink(index);
+                self.slots[index].state = State::Woken;
+                notify(self.slots[index].tcs.expect("occupied waiter"));
+                count += 1;
+            }
+            at = next;
+        }
+        count
+    }
+    /// Same-bucket original requeue keeps position; cross-bucket original
+    /// requeue appends to target FIFO. Traversal stops at the old tail so moving
+    /// source nodes to the tail cannot select them repeatedly.
+    pub fn requeue(&mut self, old: usize, new: usize, new_bucket: usize, maximum: usize) -> usize {
+        let stop = self.tail;
+        let mut at = self.head;
+        let mut count = 0;
+        while let Some(index) = at {
+            let next = self.slots[index].next;
+            if count < maximum && self.slots[index].key == old {
+                if self.slots[index].bucket != new_bucket {
+                    self.unlink(index);
+                    self.append(index);
+                }
+                self.slots[index].key = new;
+                self.slots[index].bucket = new_bucket;
+                count += 1;
+            }
+            if Some(index) == stop {
+                break;
+            }
+            at = next;
+        }
+        count
+    }
+    pub fn finish(&mut self, ticket: Ticket<T>) -> Result<(), AllocError> {
+        if !self.valid(ticket) {
+            return Err(AllocError);
+        }
+        self.unlink(ticket.index);
+        self.slots[ticket.index].state = State::Vacant;
+        self.slots[ticket.index].tcs = None;
+        Ok(())
+    }
+}
