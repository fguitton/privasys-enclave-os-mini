+//! Trusted, fixed-size allocation ownership shared across SDK layers.
+//! Carries physical lifetime only, never source, signing or caller authority.
+use core::{alloc::{Layout, Allocator, AllocError}, ptr::NonNull};
+#[derive(Clone, Copy)]
+#[repr(C)]
+pub struct AllocationTicket { pub owner: usize, pub loan: usize }
+pub struct OriginOperations {
+    pub retain: fn(AllocationTicket) -> AllocationTicket,
+    pub release: fn(AllocationTicket),
+}
+/// Implementations admit the complete backend before allocation and refund only
+/// after actual backend free. They may allocate only the admitted backing and must not wait or unwind.
+pub struct AllocationOperations {
+    pub allocate: fn(AllocationTicket, Layout, bool) -> Result<NonNull<[u8]>, ()>,
+    pub deallocate: unsafe fn(AllocationTicket, NonNull<u8>, Layout),
+    pub resize: unsafe fn(AllocationTicket, NonNull<u8>, Layout, Layout, bool) -> Result<NonNull<[u8]>, ()>,
+}
+/// Every capability owns one original origin reference; backing allocations
+/// issued through it must retain independent origin tickets until deallocation.
+pub struct AllocationCapability {
+    origin: AllocationTicket,
+    operations: &'static AllocationOperations,
+    ownership: Option<&'static OriginOperations>,
+}
+impl AllocationCapability {
+    /// # Safety
+    /// Moves exactly one retained, thread-safe origin reference. Both operation
+    /// tables must preserve original pool identity and alias lifetime. Callbacks
+    /// may not access invalid mutable state through caller-declared raw userdata.
+    pub unsafe fn from_retained_origin(
+        origin: AllocationTicket,
+        operations: &'static AllocationOperations,
+        ownership: &'static OriginOperations,
+    ) -> Self { Self { origin, operations, ownership: Some(ownership) } }
+    /// # Safety
+    /// The process-lived backend needs no origin ownership and must satisfy the
+    /// same allocation/free contracts. This is for the SDK's unchanged System.
+    pub const unsafe fn process_backend(operations: &'static AllocationOperations) -> Self {
+        Self { origin: AllocationTicket { owner: 0, loan: 0 }, operations, ownership: None }
+    }
+    pub fn allocate_block(&self, layout: Layout, zero: bool) -> Result<NonNull<[u8]>, ()> {
+        (self.operations.allocate)(self.origin, layout, zero)
+    }
+    /// # Safety
+    /// Pointer/layout belong to one exclusive allocation issued by this backend.
+    pub unsafe fn deallocate_block(&self, pointer: NonNull<u8>, layout: Layout) {
+        unsafe { (self.operations.deallocate)(self.origin, pointer, layout) }
+    }
+    /// # Safety
+    /// Pointer/old layout are live and exclusively owned; failure preserves both.
+    pub unsafe fn resize_block(&self, pointer: NonNull<u8>, old: Layout, new: Layout, zero: bool)
+        -> Result<NonNull<[u8]>, ()> {
+        unsafe { (self.operations.resize)(self.origin, pointer, old, new, zero) }
+    }
+}
+impl Clone for AllocationCapability {
+    fn clone(&self) -> Self {
+        let origin = self.ownership.map_or(self.origin, |hooks| (hooks.retain)(self.origin));
+        Self { origin, operations: self.operations, ownership: self.ownership }
+    }
+}
+impl Drop for AllocationCapability {
+    fn drop(&mut self) { if let Some(hooks) = self.ownership { (hooks.release)(self.origin); } }
+}
+// SAFETY: both unsafe constructors require thread-safe static backend and
+// retained ownership operations. No lifetime is inferred from raw integers.
+unsafe impl Send for AllocationCapability {}
+unsafe impl Sync for AllocationCapability {}
+
+// SAFETY: the unsafe constructors establish the backend Allocator contracts;
+// the capability retains its original context through every operation/alias.
+unsafe impl Allocator for AllocationCapability {
+    fn allocate(&self, layout: Layout) -> Result<NonNull<[u8]>, AllocError> { self.allocate_block(layout, false).map_err(|_| AllocError) }
+    fn allocate_zeroed(&self, layout: Layout) -> Result<NonNull<[u8]>, AllocError> { self.allocate_block(layout, true).map_err(|_| AllocError) }
+    unsafe fn deallocate(&self, ptr: NonNull<u8>, layout: Layout) { unsafe { self.deallocate_block(ptr, layout) } }
+    unsafe fn grow(&self, ptr: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<[u8]>, AllocError> { unsafe { self.resize_block(ptr, old, new, false).map_err(|_| AllocError) } }
+    unsafe fn grow_zeroed(&self, ptr: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<[u8]>, AllocError> { unsafe { self.resize_block(ptr, old, new, true).map_err(|_| AllocError) } }
+    unsafe fn shrink(&self, ptr: NonNull<u8>, old: Layout, new: Layout) -> Result<NonNull<[u8]>, AllocError> { unsafe { self.resize_block(ptr, old, new, false).map_err(|_| AllocError) } }
+}
