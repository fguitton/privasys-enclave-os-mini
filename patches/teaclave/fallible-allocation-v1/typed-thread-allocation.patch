+//! SDK-native default backend for the neutral owned allocator contract.
+use alloc::alloc::Global;
+use core::{alloc::{Allocator, Layout}, ptr::NonNull};
+use sgx_types::memory::{AllocationCapability, AllocationOperations, AllocationTicket};
+fn allocate(_: AllocationTicket, layout: Layout, zero: bool) -> Result<NonNull<[u8]>, ()> {
+    if zero { Global.allocate_zeroed(layout) } else { Global.allocate(layout) }.map_err(|_| ())
+}
+unsafe fn deallocate(_: AllocationTicket, ptr: NonNull<u8>, layout: Layout) {
+    unsafe { Global.deallocate(ptr, layout) }
+}
+unsafe fn resize(_: AllocationTicket, ptr: NonNull<u8>, old: Layout, new: Layout, zero: bool)
+    -> Result<NonNull<[u8]>, ()> {
+    unsafe {
+        if new.size() < old.size() { Global.shrink(ptr, old, new) }
+        else if zero { Global.grow_zeroed(ptr, old, new) } else { Global.grow(ptr, old, new) }
+    }.map_err(|_| ())
+}
+static SYSTEM: AllocationOperations = AllocationOperations { allocate, deallocate, resize };
+pub(super) fn system() -> AllocationCapability {
+    // SAFETY: unchanged process-lived Global backend; it has no borrowed origin.
+    unsafe { AllocationCapability::process_backend(&SYSTEM) }
+}
