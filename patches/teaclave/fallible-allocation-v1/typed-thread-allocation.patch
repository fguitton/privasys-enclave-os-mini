+//! Typed allocator capability; default System has no borrowed origin.
+use super::System;
+use core::{alloc::{Allocator, Layout}, ptr::NonNull};
+pub use sgx_types::memory::{AllocationCapability as OwnedAllocator, AllocationOperations, OriginOperations, AllocationTicket};
+fn allocate(_: AllocationTicket, layout: Layout, zero: bool) -> Result<NonNull<[u8]>, ()> {
+    if zero { System.allocate_zeroed(layout) } else { System.allocate(layout) }.map_err(|_| ())
+}
+unsafe fn deallocate(_: AllocationTicket, ptr: NonNull<u8>, layout: Layout) { unsafe { System.deallocate(ptr, layout) } }
+unsafe fn resize(_: AllocationTicket, ptr: NonNull<u8>, old: Layout, new: Layout, zero: bool) -> Result<NonNull<[u8]>, ()> {
+    unsafe { if new.size() < old.size() { System.shrink(ptr, old, new) }
+        else if zero { System.grow_zeroed(ptr, old, new) } else { System.grow(ptr, old, new) } }.map_err(|_| ())
+}
+static SYSTEM: AllocationOperations = AllocationOperations { allocate, deallocate, resize };
+pub fn system_allocator() -> OwnedAllocator { unsafe { OwnedAllocator::process_backend(&SYSTEM) } }
