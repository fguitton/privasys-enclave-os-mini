# Version 1: owned outputs for the existing reviewed Teaclave sysroot recipe.
# This file verifies inputs and declares build provenance. It never edits the SDK.

# The fallible-allocation source profile adds a direct SDK dependency. Its
# locked dependency edge must be an exact guarded before/after image.
set(_locked_std_original_hash "e5f79c0fa641c519795bc43c4b204aa0351a94b4f9ee599f8c642be58ac54e99")
set(_lock_profile "${CMAKE_SOURCE_DIR}/patches/teaclave/fallible-allocation-v1/manifest.json")
if(NOT EXISTS "${_lock_profile}" OR IS_SYMLINK "${_lock_profile}")
    message(FATAL_ERROR "Locked SDK dependency profile is unavailable")
endif()
file(READ "${_lock_profile}" _lock_json)
string(JSON _lock_count LENGTH "${_lock_json}" files)
set(_lock_matches 0)
if(_lock_count GREATER 0)
    math(EXPR _lock_last "${_lock_count}-1")
    foreach(_index RANGE 0 ${_lock_last})
        string(JSON _relative GET "${_lock_json}" files ${_index} path)
        if(_relative STREQUAL "rustlib/std/Cargo.lock")
            math(EXPR _lock_matches "${_lock_matches}+1")
            string(JSON _before GET "${_lock_json}" files ${_index} before_sha256)
            string(JSON _after GET "${_lock_json}" files ${_index} after_sha256)
            if(NOT _before STREQUAL _locked_std_original_hash)
                message(FATAL_ERROR "SDK dependency lock has another original identity")
            endif()
            set(_locked_std_selected_hash "${_after}")
        endif()
    endforeach()
endif()
if(NOT _lock_matches EQUAL 1)
    message(FATAL_ERROR "SDK dependency lock profile is absent or ambiguous")
endif()

foreach(_pair IN ITEMS
    "CMakeLists.txt|2d9182fa1db6d902ad62b0b082997aee8578880f483ce4f11eda02ad3a11f378"
    "rustlib/std/Cargo.lock|${_locked_std_selected_hash}")
    string(REPLACE "|" ";" _parts "${_pair}")
    list(GET _parts 0 _relative)
    list(GET _parts 1 _expected)
    set(_file "${TEACLAVE_CHECKOUT}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Source-locked sysroot input is unavailable: ${_relative}")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Prepare the reviewed reproducible-sysroot patch: ${_relative}")
    endif()
endforeach()

file(REAL_PATH "${CMAKE_BINARY_DIR}" _build_real)
file(REAL_PATH "${TEACLAVE_CHECKOUT}" _sdk_real)
foreach(_relative IN ITEMS sgx-sysroot teaclave-sysroot-build)
    set(_path "${CMAKE_BINARY_DIR}/${_relative}")
    file(REAL_PATH "${_path}" _real)
    string(FIND "${_real}/" "${_sdk_real}/" _inside_sdk)
    if(IS_SYMLINK "${_path}" OR NOT _real STREQUAL "${_build_real}/${_relative}"
       OR _inside_sdk EQUAL 0)
        message(FATAL_ERROR "Sysroot output is not owned by this build: ${_path}")
    endif()
endforeach()

# The SDK mirror deliberately has no Git metadata. Enumerate the same immutable
# commit in the original identity checkout, then hash the selected patched mirror.
# Do not glob generated Autotools or Cargo output back into the input set.
execute_process(
    COMMAND git -C "${TEACLAVE_IDENTITY_CHECKOUT}" ls-tree -r --name-only "${TEACLAVE_FULL_REV}"
    RESULT_VARIABLE _tree_status OUTPUT_VARIABLE _tree_files
    OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT _tree_status EQUAL 0 OR _tree_files STREQUAL "")
    message(FATAL_ERROR "Cannot enumerate pinned Teaclave compiler inputs")
endif()
string(REPLACE "\n" ";" _sdk_files "${_tree_files}")
list(APPEND _sdk_files "rustlib/std/Cargo.lock")

# Source ABI profile. It has no global allocator.
set(_allocation_profile_files)
set(_allocation_profile_root "${CMAKE_SOURCE_DIR}/patches/teaclave/fallible-allocation-v1")
set(_allocation_manifest "${_allocation_profile_root}/manifest.json")
if(NOT EXISTS "${_allocation_manifest}" OR IS_SYMLINK "${_allocation_manifest}")
    message(FATAL_ERROR "Fallible allocator source manifest is unavailable")
endif()
file(READ "${_allocation_manifest}" _allocation_json)
string(JSON _allocation_schema GET "${_allocation_json}" schema)
string(JSON _allocation_profile GET "${_allocation_json}" profile)
string(JSON _allocation_base GET "${_allocation_json}" base_sdk_commit)
if(NOT _allocation_base STREQUAL TEACLAVE_FULL_REV)
    message(FATAL_ERROR "Fallible allocation profile has another SDK revision")
endif()
if(NOT _allocation_schema EQUAL 1 OR NOT _allocation_profile STREQUAL "fallible-allocation-v1")
    message(FATAL_ERROR "Unsupported fallible allocation profile")
endif()
string(JSON _allocation_count LENGTH "${_allocation_json}" files)
if(_allocation_count LESS 1)
    message(FATAL_ERROR "Fallible allocation profile has no source files")
endif()
math(EXPR _allocation_last "${_allocation_count}-1")
foreach(_index RANGE 0 ${_allocation_last})
    string(JSON _relative GET "${_allocation_json}" files ${_index} path)
    string(JSON _expected GET "${_allocation_json}" files ${_index} after_sha256)
    if(_relative MATCHES "(^/|(^|/)[.][.](/|$))")
        message(FATAL_ERROR "Invalid fallible allocator source path")
    endif()
    set(_file "${TEACLAVE_CHECKOUT}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Fallible allocator source is unavailable: ${_relative}")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Fallible allocator source differs: ${_relative}")
    endif()
    list(APPEND _sdk_files "${_relative}")
endforeach()
list(APPEND _allocation_profile_files "${_allocation_manifest}")
# Read-only SDK compilation requires the original bounded Autotools recipe.
# Include every actual generated input in this new std identity, instead of
# silently mounting compiler bytes outside the tracked Git enumeration.
set(HONEST_TEACLAVE_FALLIBLE_AUTOTOOLS_RECEIPT "" CACHE FILEPATH
    "Exact task-owned pregenerated libunwind input receipt")
if(NOT EXISTS "${HONEST_TEACLAVE_FALLIBLE_AUTOTOOLS_RECEIPT}" OR
   IS_SYMLINK "${HONEST_TEACLAVE_FALLIBLE_AUTOTOOLS_RECEIPT}")
    message(FATAL_ERROR "Fallible std source needs its pregenerated input receipt")
endif()
file(READ "${HONEST_TEACLAVE_FALLIBLE_AUTOTOOLS_RECEIPT}" _autotools_json)
string(JSON _autotools_schema GET "${_autotools_json}" schema)
string(JSON _autotools_count LENGTH "${_autotools_json}" files)
if(NOT _autotools_schema EQUAL 1 OR _autotools_count LESS 1)
    message(FATAL_ERROR "Invalid pregenerated SDK input receipt")
endif()
math(EXPR _autotools_last "${_autotools_count}-1")
foreach(_index RANGE 0 ${_autotools_last})
    string(JSON _relative GET "${_autotools_json}" files ${_index} path)
    string(JSON _expected GET "${_autotools_json}" files ${_index} sha256)
    if(NOT _relative MATCHES "^sgx_unwind/libunwind/" OR
       _relative MATCHES "(^/|(^|/)[.][.](/|$))")
        message(FATAL_ERROR "Invalid pregenerated SDK input path")
    endif()
    set(_file "${TEACLAVE_CHECKOUT}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Pregenerated SDK input is unavailable")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Pregenerated SDK input differs: ${_relative}")
    endif()
    list(APPEND _sdk_files "${_relative}")
endforeach()
list(APPEND _allocation_profile_files "${HONEST_TEACLAVE_FALLIBLE_AUTOTOOLS_RECEIPT}")
string(JSON _generation_count LENGTH "${_allocation_json}" build_inputs)
if(_generation_count LESS 1)
    message(FATAL_ERROR "SDK source generation has no declared owner")
endif()
math(EXPR _generation_last "${_generation_count}-1")
foreach(_index RANGE 0 ${_generation_last})
    string(JSON _relative GET "${_allocation_json}" build_inputs ${_index} path)
    string(JSON _expected GET "${_allocation_json}" build_inputs ${_index} sha256)
    if(_relative MATCHES "(^/|(^|/)[.][.](/|$))")
        message(FATAL_ERROR "Invalid SDK source generation owner path")
    endif()
    set(_file "${_allocation_profile_root}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "SDK source generation owner is unavailable")
    endif()
    file(SHA256 "${_file}" _actual)
    string(JSON _binding GET "${_autotools_json}" bindings "${_file}")
    if(NOT _actual STREQUAL _expected OR NOT _binding STREQUAL _expected)
        message(FATAL_ERROR "SDK source generation owner/binding differs")
    endif()
    list(APPEND _allocation_profile_files "${_file}")
endforeach()
string(JSON _generation_owner GET "${_allocation_json}" autotools_owner path)
string(JSON _generation_expected GET "${_allocation_json}" autotools_owner sha256)
set(_generation_owner "${RUST_ENCLAVE_SOURCE_ROOT}/${_generation_owner}")
if(NOT EXISTS "${_generation_owner}" OR IS_SYMLINK "${_generation_owner}")
    message(FATAL_ERROR "Original SDK input generation owner is unavailable")
endif()
file(SHA256 "${_generation_owner}" _generation_actual)
string(JSON _generation_binding GET "${_autotools_json}" bindings "${_generation_owner}")
if(NOT _generation_actual STREQUAL _generation_expected OR
   NOT _generation_binding STREQUAL _generation_expected)
    message(FATAL_ERROR "Original SDK input generation owner/binding differs")
endif()
list(APPEND _allocation_profile_files "${_generation_owner}")
string(JSON _patch_count LENGTH "${_allocation_json}" patches)
if(_patch_count LESS 1)
    message(FATAL_ERROR "Fallible allocation profile has no source patches")
endif()
math(EXPR _patch_last "${_patch_count}-1")
foreach(_index RANGE 0 ${_patch_last})
    string(JSON _relative GET "${_allocation_json}" patches ${_index} path)
    string(JSON _expected GET "${_allocation_json}" patches ${_index} sha256)
    if(_relative MATCHES "(^/|(^|/)[.][.](/|$))")
        message(FATAL_ERROR "Invalid fallible allocator patch path")
    endif()
    set(_file "${_allocation_profile_root}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Fallible allocator patch is unavailable")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Fallible allocator patch differs: ${_relative}")
    endif()
    list(APPEND _allocation_profile_files "${_file}")
endforeach()
list(REMOVE_DUPLICATES _sdk_files)
list(SORT _sdk_files)
set(_btree_std_environment)
set(_btree_source_files)
set(HONEST_BTREE_SOURCE_RECEIPT "")
set(_btree_inputs "")
find_program(HONEST_BTREE_SOURCE_PYTHON python3 REQUIRED)
get_filename_component(_btree_compiler_bin "${CARGO_EXECUTABLE}" DIRECTORY)
set(_btree_build_root "${SGX_SYSROOT_BTREE_SOURCE_DIR}")
set(_btree_source_record "${_btree_build_root}/inputs.json")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    "RUSTUP_TOOLCHAIN=${RUST_ENCLAVE_TOOLCHAIN}"
    "${HONEST_BTREE_SOURCE_PYTHON}" -B
    "${CMAKE_SOURCE_DIR}/scripts/run-fallible-btree-cargo.py"
    --rustc "${_btree_compiler_bin}/rustc"
    --build-root "${_btree_build_root}" --output "${_btree_source_record}"
    RESULT_VARIABLE _btree_status)
if(NOT _btree_status EQUAL 0)
    message(FATAL_ERROR "Current fallible BTree compiler-source acquisition failed")
endif()
file(READ "${_btree_source_record}" _btree_json)
string(JSON _btree_schema GET "${_btree_json}" schema)
string(JSON _btree_profile GET "${_btree_json}" profile)
if(NOT _btree_schema EQUAL 1 OR NOT _btree_profile STREQUAL "fallible-btree-insertion")
    message(FATAL_ERROR "Current BTree compiler-source receipt differs")
endif()
string(JSON _btree_rustc GET "${_btree_json}" rustc)
string(JSON _btree_sysroot GET "${_btree_json}" sysroot)
string(JSON HONEST_BTREE_SOURCE_RECEIPT GET "${_btree_json}" receipt)
list(APPEND _btree_std_environment "RUSTC=${_btree_rustc}" "SYSROOT=${_btree_sysroot}")
string(JSON _btree_count LENGTH "${_btree_json}" inputs)
if(_btree_count LESS 1)
    message(FATAL_ERROR "Current BTree compiler source is empty")
endif()
math(EXPR _btree_last "${_btree_count}-1")
foreach(_index RANGE 0 ${_btree_last})
    string(JSON _file GET "${_btree_json}" inputs ${_index} path)
    string(JSON _name GET "${_btree_json}" inputs ${_index} name)
    string(JSON _expected GET "${_btree_json}" inputs ${_index} sha256)
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Current BTree compiler input is unavailable: ${_name}")
    endif()
    file(SHA256 "${_file}" _actual)
    if(NOT _actual STREQUAL _expected)
        message(FATAL_ERROR "Current BTree compiler input differs: ${_name}")
    endif()
    string(APPEND _btree_inputs "${_name}=${_actual}\n")
    list(APPEND _btree_source_files "${_file}")
endforeach()
set(SGX_SYSROOT_INPUT_FILES)
set(_inputs "owned-teaclave-sysroot-v1\ncommit=${TEACLAVE_FULL_REV}\n${_btree_inputs}")
list(APPEND SGX_SYSROOT_INPUT_FILES ${_btree_source_files})
string(APPEND _inputs "allocation_source_profile=fallible-allocation-v1\n")
foreach(_file IN LISTS _allocation_profile_files)
    file(SHA256 "${_file}" _sha)
    string(APPEND _inputs "allocation_profile_input=${_sha}\n")
    list(APPEND SGX_SYSROOT_INPUT_FILES "${_file}")
endforeach()
foreach(_relative IN LISTS _sdk_files)
    set(_file "${TEACLAVE_CHECKOUT}/${_relative}")
    if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
        message(FATAL_ERROR "Pinned Teaclave input is unavailable: ${_relative}")
    endif()
    file(SHA256 "${_file}" _sha)
    string(APPEND _inputs "sdk/${_relative}=${_sha}\n")
    list(APPEND SGX_SYSROOT_INPUT_FILES "${_file}")
endforeach()
foreach(_file IN ITEMS
    "${CMAKE_SOURCE_DIR}/Cargo.lock" "${CMAKE_SOURCE_DIR}/CMakeLists.txt"
    "${CMAKE_CURRENT_LIST_FILE}" "${CMAKE_SOURCE_DIR}/cmake/RustBuild.cmake"
    "${CMAKE_SOURCE_DIR}/cmake/SgxConfig.cmake"
    "${CMAKE_C_COMPILER}" "${CMAKE_CXX_COMPILER}" "${CARGO_EXECUTABLE}"
    "${SGX_SDK_PATH}/pkgconfig/libsgx_urts.pc" "${SGX_SDK_PATH}/lib64/libsgx_tcrypto.a")
    file(SHA256 "${_file}" _sha)
    string(APPEND _inputs "input=${_sha}\n")
    list(APPEND SGX_SYSROOT_INPUT_FILES "${_file}")
endforeach()
get_filename_component(SGX_SYSROOT_CARGO_BIN_DIR "${CARGO_EXECUTABLE}" DIRECTORY)
get_filename_component(_cargo_name "${CARGO_EXECUTABLE}" NAME)
if(NOT _cargo_name STREQUAL "cargo")
    message(FATAL_ERROR "The pinned Teaclave recipe requires the selected cargo executable name")
endif()
execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env "RUSTUP_TOOLCHAIN=${RUST_ENCLAVE_TOOLCHAIN}"
        "${SGX_SYSROOT_CARGO_BIN_DIR}/rustc" --version --verbose
    RESULT_VARIABLE _rust_status OUTPUT_VARIABLE _rust_version)
if(NOT _rust_status EQUAL 0)
    message(FATAL_ERROR "Cannot identify the selected enclave Rust compiler")
endif()
string(APPEND _inputs
    "rustc=${_rust_version}\nmode=${SGX_MODE}\nbuild_type=${CMAKE_BUILD_TYPE}\n"
    "toolchain=${RUST_ENCLAVE_TOOLCHAIN}\nbackend=${SGX_CRYPTO_BACKEND}\n"
    "epoch=${SOURCE_DATE_EPOCH}\ncc=${CMAKE_C_COMPILER_ID}:${CMAKE_C_COMPILER_VERSION}\n"
    "cxx=${CMAKE_CXX_COMPILER_ID}:${CMAKE_CXX_COMPILER_VERSION}\n"
    "cflags=${CMAKE_C_FLAGS}\ncxxflags=${CMAKE_CXX_FLAGS}\n"
    "input_remaps=${RUST_REPRODUCIBLE_INPUT_REMAP_FLAGS}\n"
    "use_opt_libs=0\ncargo_incremental=0\n")
string(SHA256 SGX_SYSROOT_INPUT_ID "${_inputs}")
# The nested CMake cache is also input-owned. Changing compiler/profile cannot
# reuse a cache whose compiler reset discards the explicit output directory.
set(SYSROOT_BUILD_DIR "${SYSROOT_BUILD_DIR}/${SGX_SYSROOT_INPUT_ID}")
set(SGX_STD_TARGET_DIR "${SYSROOT_BUILD_DIR}/rustlib-std-target")
file(REAL_PATH "${SGX_STD_TARGET_DIR}" _target_real)
if(NOT _target_real STREQUAL
    "${_build_real}/teaclave-sysroot-build/${SGX_SYSROOT_INPUT_ID}/rustlib-std-target")
    message(FATAL_ERROR "Sysroot Cargo output escaped its build owner")
endif()
set(SGX_SYSROOT_INPUTS_FILE "${CMAKE_BINARY_DIR}/teaclave-sysroot-inputs-v1.txt")
file(GENERATE OUTPUT "${SGX_SYSROOT_INPUTS_FILE}" CONTENT "${_inputs}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${SGX_SYSROOT_INPUT_FILES})
